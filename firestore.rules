rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All: Any document not explicitly matched is denied
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // REUSABLE SECURITY & VALIDATION HELPERS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isIsoDate(val) {
      return val is string && (val.matches('^\\d{4}-\\d{2}-\\d{2}$') || val.matches('^\\d{4}-\\d{2}-\\d{2}T.*$'));
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isPositivePaise(val) {
      return (val is int || val is float) && val > 0 && val <= 1000000000000 && int(val) == val;
    }

    function isNonNegativePaise(val) {
      return (val is int || val is float) && val >= 0 && val <= 1000000000000 && int(val) == val;
    }

    function isBoundedInt(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal && int(val) == val;
    }

    function isValidRatioValue(val) {
      return (val is int || val is float) && val >= 0 && val <= 100;
    }

    function isValidTargetRatio(ratio, memberUids) {
      return ratio is map
        && ratio.size() <= 2
        && (
          memberUids.size() == 0 ||
          (
            memberUids.size() == 1 &&
            (!(memberUids[0] in ratio) || isValidRatioValue(ratio[memberUids[0]]))
          ) ||
          (
            memberUids.size() == 2 &&
            (!(memberUids[0] in ratio) || isValidRatioValue(ratio[memberUids[0]])) &&
            (!(memberUids[1] in ratio) || isValidRatioValue(ratio[memberUids[1]]))
          )
        );
    }

    function isSoftDelete(resourceData) {
      return resourceData != null && (
        request.resource.data.diff(resourceData).affectedKeys().hasOnly(['deletedAt', 'updatedAt']) ||
        request.resource.data.diff(resourceData).affectedKeys().hasOnly(['deletedAt'])
      ) && (
        !('userId' in resourceData) || request.resource.data.userId == resourceData.userId
      ) && (
        !('id' in resourceData) || request.resource.data.id == resourceData.id
      ) && (
        !('createdAt' in resourceData) || request.resource.data.createdAt == resourceData.createdAt
      ) && (
        request.resource.data.deletedAt == null ||
        (request.resource.data.deletedAt is string && request.resource.data.deletedAt.size() <= 64)
      ) && (
        !('updatedAt' in request.resource.data) ||
        (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 64)
      );
    }

    // Test connection doc for client health-checks
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // USER WORKSPACE ROOT
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == userId
        && isNonEmptyString(request.resource.data.email, 256)
        && isNonEmptyString(request.resource.data.name, 128);
      allow update: if isOwner(userId)
        && request.resource.data.id == userId
        && isNonEmptyString(request.resource.data.email, 256)
        && isNonEmptyString(request.resource.data.name, 128);
      allow delete: if false; // Protect root user profile from accidental deletion

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId);
        allow delete: if isOwner(userId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && request.resource.data.priority in ['low', 'medium', 'high']
          && request.resource.data.status in ['todo', 'in_progress', 'completed']
          && isBoundedInt(request.resource.data.estimatedPomodoros, 1, 100);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) ||
            (
              isNonEmptyString(request.resource.data.title, 256)
              && request.resource.data.priority in ['low', 'medium', 'high']
              && request.resource.data.status in ['todo', 'in_progress', 'completed']
            )
          );
        allow delete: if isOwner(userId);
      }

      // Focus sessions subcollection
      match /focus_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(sessionId)
          && request.resource.data.userId == userId
          && request.resource.data.mode in ['work', 'short_break', 'long_break']
          && isBoundedInt(request.resource.data.durationSeconds, 1, 86400)
          && request.resource.data.completed is bool
          && isNonEmptyString(request.resource.data.startedAt, 64)
          && (
            !('status' in request.resource.data) ||
            request.resource.data.status in ['in_progress', 'completed', 'interrupted']
          )
          && (
            !('actualDurationSeconds' in request.resource.data) ||
            isBoundedInt(request.resource.data.actualDurationSeconds, 0, 86400)
          )
          && (
            !('pauseCount' in request.resource.data) ||
            (request.resource.data.pauseCount is int && request.resource.data.pauseCount >= 0)
          )
          && (
            !('totalPauseSeconds' in request.resource.data) ||
            (request.resource.data.totalPauseSeconds is int && request.resource.data.totalPauseSeconds >= 0)
          );
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.startedAt == resource.data.startedAt
          && (
            !('status' in request.resource.data) ||
            request.resource.data.status in ['in_progress', 'completed', 'interrupted']
          )
          && (
            !('actualDurationSeconds' in request.resource.data) ||
            isBoundedInt(request.resource.data.actualDurationSeconds, 0, 86400)
          )
          && (
            !('pauseCount' in request.resource.data) ||
            (request.resource.data.pauseCount is int && request.resource.data.pauseCount >= 0)
          )
          && (
            !('totalPauseSeconds' in request.resource.data) ||
            (request.resource.data.totalPauseSeconds is int && request.resource.data.totalPauseSeconds >= 0)
          );
        allow delete: if isOwner(userId);

        // Nested interruptions subcollection (Phase 17)
        match /interruptions/{eventId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(eventId)
            && request.resource.data.userId == userId
            && request.resource.data.sessionId == sessionId
            && request.resource.data.eventType in ['pause', 'resume']
            && isNonEmptyString(request.resource.data.occurredAt, 64);
          allow update, delete: if false; // Append-only immutable audit trail
        }
      }

      // Income records subcollection
      match /income/{incomeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(incomeId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.source, 256)
          && isPositivePaise(request.resource.data.amountPaise)
          && isIsoDate(request.resource.data.date);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.source, 256)
              && isPositivePaise(request.resource.data.amountPaise)
              && isIsoDate(request.resource.data.date)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['source', 'amountPaise', 'date', 'category', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Recurring expenses subcollection
      match /recurring_expenses/{recId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(recId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 256)
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.recurrence in ['monthly', 'quarterly', 'yearly']
          && isBoundedInt(request.resource.data.dueDay, 1, 31);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.name, 256)
              && isPositivePaise(request.resource.data.amountPaise)
              && request.resource.data.recurrence in ['monthly', 'quarterly', 'yearly']
              && isBoundedInt(request.resource.data.dueDay, 1, 31)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'amountPaise', 'category', 'recurrence', 'dueDay', 'autoPaid', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Expense transactions subcollection
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(expenseId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.description, 256)
          && isPositivePaise(request.resource.data.amountPaise)
          && isIsoDate(request.resource.data.date)
          && request.resource.data.type in ['fixed', 'variable']
          && request.resource.data.paymentMethod in ['credit_card', 'debit_card', 'upi_bank', 'cash', 'other'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.description, 256)
              && isPositivePaise(request.resource.data.amountPaise)
              && isIsoDate(request.resource.data.date)
              && request.resource.data.type in ['fixed', 'variable']
              && request.resource.data.paymentMethod in ['credit_card', 'debit_card', 'upi_bank', 'cash', 'other']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'amountPaise', 'date', 'type', 'paymentMethod', 'categoryId', 'categoryName', 'categoryColor', 'billId', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Bills subcollection
      match /bills/{billId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(billId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 256)
          && isPositivePaise(request.resource.data.amountPaise)
          && isIsoDate(request.resource.data.dueDate)
          && request.resource.data.status in ['PAID', 'UNPAID', 'OVERDUE'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.name, 256)
              && isPositivePaise(request.resource.data.amountPaise)
              && isIsoDate(request.resource.data.dueDate)
              && request.resource.data.status in ['PAID', 'UNPAID', 'OVERDUE']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'amountPaise', 'dueDate', 'category', 'status', 'isAutoPay', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Payment history subcollection
      match /payment_history/{payId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(payId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.billId, 128)
          && isPositivePaise(request.resource.data.amountPaise)
          && isIsoDate(request.resource.data.paidDate)
          && request.resource.data.paymentMethod in ['credit_card', 'debit_card', 'upi_bank', 'cash', 'other'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Sync queue subcollection (Durable Google Sheets synchronization)
      match /sync_queue/{queueId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(queueId)
          && request.resource.data.userId == userId
          && request.resource.data.status in ['pending', 'processing', 'completed', 'failed'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.status in ['pending', 'processing', 'completed', 'failed'];
        allow delete: if isOwner(userId);
      }

      // Time blocks subcollection (Daily Time-Block Planner)
      match /time_blocks/{blockId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(blockId)
          && request.resource.data.userId == userId
          && isIsoDate(request.resource.data.date)
          && isNonEmptyString(request.resource.data.title, 256)
          && isBoundedInt(request.resource.data.startMinute, 0, 1440)
          && isBoundedInt(request.resource.data.endMinute, 0, 1440)
          && request.resource.data.endMinute > request.resource.data.startMinute;
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isIsoDate(request.resource.data.date)
              && isNonEmptyString(request.resource.data.title, 256)
              && isBoundedInt(request.resource.data.startMinute, 0, 1440)
              && isBoundedInt(request.resource.data.endMinute, 0, 1440)
              && request.resource.data.endMinute > request.resource.data.startMinute
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'date', 'startMinute', 'endMinute', 'color', 'category', 'completed', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Envelopes subcollection (Envelope Budgeting)
      match /envelopes/{envelopeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(envelopeId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 128)
          && isNonNegativePaise(request.resource.data.allocatedPaise);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.name, 128)
              && isNonNegativePaise(request.resource.data.allocatedPaise)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'allocatedPaise', 'spentPaise', 'color', 'icon', 'category', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Subscriptions subcollection (Subscription Manager)
      match /subscriptions/{subId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(subId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 256)
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.billingCycle in ['monthly', 'quarterly', 'yearly']
          && isIsoDate(request.resource.data.nextRenewalDate);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.name, 256)
              && isPositivePaise(request.resource.data.amountPaise)
              && request.resource.data.billingCycle in ['monthly', 'quarterly', 'yearly']
              && isIsoDate(request.resource.data.nextRenewalDate)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'amountPaise', 'billingCycle', 'category', 'nextRenewalDate', 'status', 'autoRenew', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Audit logs & Data recovery subcollection
      match /audit_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(logId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.action, 64);
        allow update: if false; // Audit logs are append-only
        allow delete: if isOwner(userId);
      }

      // Habits subcollection (Habit Tracker & Streaks)
      match /habits/{habitId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(habitId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && request.resource.data.frequency in ['daily', 'weekly', 'custom']
          && isBoundedInt(request.resource.data.targetDaysPerWeek, 1, 7);
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && isNonEmptyString(request.resource.data.title, 256)
              && request.resource.data.frequency in ['daily', 'weekly', 'custom']
              && isBoundedInt(request.resource.data.targetDaysPerWeek, 1, 7)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'category', 'color', 'frequency', 'targetDaysPerWeek', 'customDays', 'completedDates', 'bestStreakDays', 'reminderTime', 'archived', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study academic tiers subcollection (Custom User Academic Tiers)
      match /study_tiers/{tierId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(tierId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 128)
          && isNonEmptyString(request.resource.data.shortTitle, 64);
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && isNonEmptyString(request.resource.data.name, 128)
              && isNonEmptyString(request.resource.data.shortTitle, 64)
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study subjects subcollection (Academic Study OS)
      match /study_subjects/{subId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(subId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.code, 64)
          && isNonEmptyString(request.resource.data.name, 256);
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && request.resource.data.code == resource.data.code
              && isNonEmptyString(request.resource.data.name, 256)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tierId', 'semesterOrDomain', 'targetExam', 'color', 'totalSubtopics', 'completedSubtopics', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study topics subcollection (Syllabus & Topic Tracker)
      match /study_topics/{topicId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(topicId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.subjectCode, 64)
          && isNonEmptyString(request.resource.data.unit, 128)
          && isNonEmptyString(request.resource.data.subtopic, 256)
          && request.resource.data.priority in ['High', 'Medium', 'Low'];
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && request.resource.data.subjectCode == resource.data.subjectCode
              && request.resource.data.priority in ['High', 'Medium', 'Low']
              && request.resource.data.theory is bool
              && request.resource.data.practice is bool
              && request.resource.data.pyq is bool
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priority', 'theory', 'practice', 'pyq', 'revisionCount', 'notes', 'updatedAt', 'deletedAt', 'rowIndex', 'topic', 'subtopic', 'unit'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study revisions subcollection (Ebbinghaus Spaced Repetition)
      match /study_revisions/{revId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(revId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.topicId, 128)
          && isIsoDate(request.resource.data.lastStudiedAt)
          && isIsoDate(request.resource.data.nextRevisionAt)
          && request.resource.data.difficulty in ['easy', 'medium', 'hard']
          && request.resource.data.status in ['scheduled', 'due', 'overdue', 'mastered'];
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && request.resource.data.topicId == resource.data.topicId
              && request.resource.data.difficulty in ['easy', 'medium', 'hard']
              && request.resource.data.status in ['scheduled', 'due', 'overdue', 'mastered']
              && isIsoDate(request.resource.data.nextRevisionAt)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['difficulty', 'status', 'lastStudiedAt', 'nextRevisionAt', 'intervalDays', 'repetition', 'recallScore', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study mistakes subcollection (Error Log & Golden Rules)
      match /study_mistakes/{mistakeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(mistakeId)
          && request.resource.data.userId == userId
          && isIsoDate(request.resource.data.date)
          && isNonEmptyString(request.resource.data.trap, 1024)
          && isNonEmptyString(request.resource.data.goldenRule, 1024)
          && request.resource.data.severity in ['High', 'Medium', 'Low']
          && request.resource.data.resolved is bool;
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && request.resource.data.severity in ['High', 'Medium', 'Low']
              && request.resource.data.resolved is bool
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['severity', 'trap', 'rootCause', 'goldenRule', 'resolved', 'updatedAt', 'deletedAt', 'source', 'topic', 'date', 'subjectName'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study goals subcollection (Phase 16 Academic Goals & Milestones)
      match /study_goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'completed', 'paused', 'cancelled'])
              && (!('priority' in request.resource.data) || request.resource.data.priority in ['low', 'medium', 'high'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'goalType', 'subjectId', 'subjectCode', 'targetValue', 'currentValue', 'unit', 'startDate', 'endDate', 'status', 'priority', 'milestones', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study plans subcollection (Phase 16 Structured Study Plans)
      match /study_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(planId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && request.resource.data.planType in ['daily', 'weekly', 'monthly', 'semester', 'exam'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && (!('planType' in request.resource.data) || request.resource.data.planType in ['daily', 'weekly', 'monthly', 'semester', 'exam'])
              && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'completed', 'paused', 'archived'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'planType', 'subjectIds', 'startDate', 'endDate', 'dailyTargetMinutes', 'weeklyTargetMinutes', 'recurringPattern', 'status', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study plan tasks subcollection (Phase 16 Plan Tasks & Calendar)
      match /study_plan_tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && isIsoDate(request.resource.data.scheduledDate);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (!('planId' in resource.data) || request.resource.data.planId == resource.data.planId)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'in_progress', 'completed', 'skipped'])
              && (!('priority' in request.resource.data) || request.resource.data.priority in ['low', 'medium', 'high'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'subjectId', 'topicId', 'scheduledDate', 'startTime', 'endTime', 'estimatedMinutes', 'actualMinutes', 'priority', 'status', 'completedAt', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study resources subcollection (Phase 16 Reference Materials & Links)
      match /study_resources/{resourceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(resourceId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && request.resource.data.resourceType in ['pdf', 'video', 'link', 'document', 'image', 'other'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && (!('resourceType' in request.resource.data) || request.resource.data.resourceType in ['pdf', 'video', 'link', 'document', 'image', 'other'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'resourceType', 'subjectId', 'topicId', 'url', 'storagePath', 'tags', 'isBookmarked', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study exams subcollection (Phase 16 Exam Schedules & Results)
      match /study_exams/{examId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(examId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && isIsoDate(request.resource.data.examDate);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && (!('preparationStatus' in request.resource.data) || request.resource.data.preparationStatus in ['not_started', 'preparing', 'ready', 'completed'])
              && (!('resultStatus' in request.resource.data) || request.resource.data.resultStatus in ['pending', 'published'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'examType', 'subjectIds', 'examDate', 'startTime', 'durationMinutes', 'totalMarks', 'obtainedMarks', 'syllabusTopicIds', 'preparationStatus', 'resultStatus', 'notes', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study notes subcollection (Phase 16 Topic Notes & Bookmarks)
      match /study_notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'subjectId', 'topicId', 'tags', 'isPinned', 'isBookmarked', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study activity logs subcollection (Phase 16 Append-only Historical Audit)
      match /study_activity_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(logId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.activityType, 64);
        allow update: if false; // Append-only historical log
        allow delete: if false; // Immutable audit log
      }

      // Study flashcards subcollection (Phase 16 Active Recall & Spaced Repetition)
      match /study_flashcards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(cardId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.question, 1024);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.question, 1024)
              && (!('difficulty' in request.resource.data) || request.resource.data.difficulty in ['easy', 'medium', 'hard'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'answer', 'difficulty', 'reviewCount', 'lastReviewedAt', 'nextReviewAt', 'subjectId', 'topicId', 'isBookmarked', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Study quizzes subcollection (Phase 16 Self-Assessment & Performance)
      match /study_quizzes/{quizId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(quizId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (
            isSoftDelete(resource.data) || (
              isNonEmptyString(request.resource.data.title, 256)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'subjectId', 'topicId', 'questions', 'attempts', 'highestScore', 'updatedAt', 'deletedAt'])
            )
          );
        allow delete: if isOwner(userId);
      }

      // Pomodoro presets subcollection (Phase 17 standard & custom timer intervals)
      match /pomodoro_presets/{presetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(presetId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 128)
          && isBoundedInt(request.resource.data.workDuration, 1, 180)
          && isBoundedInt(request.resource.data.shortBreakDuration, 1, 60)
          && isBoundedInt(request.resource.data.longBreakDuration, 1, 90)
          && isBoundedInt(request.resource.data.longBreakInterval, 1, 12)
          && (
            !('soundVolume' in request.resource.data) ||
            isBoundedInt(request.resource.data.soundVolume, 0, 100)
          );
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && isNonEmptyString(request.resource.data.name, 128)
              && isBoundedInt(request.resource.data.workDuration, 1, 180)
              && isBoundedInt(request.resource.data.shortBreakDuration, 1, 60)
              && isBoundedInt(request.resource.data.longBreakDuration, 1, 90)
              && isBoundedInt(request.resource.data.longBreakInterval, 1, 12)
              && (
                !('soundVolume' in request.resource.data) ||
                isBoundedInt(request.resource.data.soundVolume, 0, 100)
              )
            )
          );
        allow delete: if isOwner(userId);
      }

      // Pomodoro goals subcollection (Phase 17 multi-goal architecture)
      match /pomodoro_goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.title, 256)
          && (
            !('targetValue' in request.resource.data) ||
            isBoundedInt(request.resource.data.targetValue, 1, 100000)
          )
          && (
            !('goalType' in request.resource.data) ||
            request.resource.data.goalType in ['daily', 'weekly', 'monthly', 'custom']
          )
          && (
            !('status' in request.resource.data) ||
            request.resource.data.status in ['active', 'paused', 'completed', 'cancelled']
          );
        allow update: if isOwner(userId)
          && (
            isSoftDelete(resource.data) || (
              request.resource.data.userId == resource.data.userId
              && isNonEmptyString(request.resource.data.title, 256)
              && (
                !('targetValue' in request.resource.data) ||
                isBoundedInt(request.resource.data.targetValue, 1, 100000)
              )
              && (
                !('goalType' in request.resource.data) ||
                request.resource.data.goalType in ['daily', 'weekly', 'monthly', 'custom']
              )
              && (
                !('status' in request.resource.data) ||
                request.resource.data.status in ['active', 'paused', 'completed', 'cancelled']
              )
            )
          );
        allow delete: if isOwner(userId);
      }

      // Pomodoro settings subcollection (User timer preferences fallback)
      match /pomodoro_settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Pomodoro ambient presets subcollection (Custom sound presets)
      match /pomodoro_ambient_presets/{presetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(presetId)
          && request.resource.data.userId == userId
          && isNonEmptyString(request.resource.data.name, 128);
        allow delete: if isOwner(userId);
      }
    }

    // ==========================================
    // COUPLE SHARED SAVINGS (JOINT VAULTS) ROOT
    // ==========================================
    match /sharedVaults/{vaultId} {
      function isMemberOfVault(vId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/sharedVaults/$(vId))
          && ('memberUids' in get(/databases/$(database)/documents/sharedVaults/$(vId)).data)
          && (request.auth.uid in get(/databases/$(database)/documents/sharedVaults/$(vId)).data.memberUids);
      }

      // Vault root document
      allow read: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn()
        && isValidId(vaultId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && isPositivePaise(request.resource.data.targetPaise)
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && request.resource.data.status in ['active', 'archived']
        && isNonEmptyString(request.resource.data.name, 128)
        && (!('id' in request.resource.data) || request.resource.data.id == vaultId)
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 512))
        && (!('monthlyTargetPaise' in request.resource.data) || isNonNegativePaise(request.resource.data.monthlyTargetPaise))
        && (!('targetRatio' in request.resource.data) || isValidTargetRatio(request.resource.data.targetRatio, request.resource.data.memberUids));
      allow update: if isSignedIn()
        && isMemberOfVault(vaultId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'targetPaise', 'monthlyTargetPaise', 'targetRatio', 'status', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.currency == resource.data.currency
        && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
        && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived'])
        && (!('targetPaise' in request.resource.data) || isPositivePaise(request.resource.data.targetPaise))
        && (!('name' in request.resource.data) || isNonEmptyString(request.resource.data.name, 128))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 512))
        && (!('monthlyTargetPaise' in request.resource.data) || isNonNegativePaise(request.resource.data.monthlyTargetPaise))
        && (!('targetRatio' in request.resource.data) || isValidTargetRatio(request.resource.data.targetRatio, resource.data.memberUids));
      allow delete: if false;

      // Subcollection: members
      match /members/{memberUid} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if (isMemberOfVault(vaultId) || (isSignedIn() && request.auth.uid == memberUid))
          && isValidId(memberUid)
          && request.resource.data.uid == memberUid
          && isNonEmptyString(request.resource.data.name, 128)
          && (!('role' in request.resource.data) || request.resource.data.role in ['creator', 'partner'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'left']);
        allow update: if isSignedIn()
          && request.auth.uid == memberUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && (!('name' in request.resource.data) || isNonEmptyString(request.resource.data.name, 128));
        allow delete: if false;
      }

      // Subcollection: invitations
      match /invitations/{inviteId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isMemberOfVault(vaultId)
          && isValidId(inviteId)
          && request.resource.data.invitedByUid == request.auth.uid
          && request.resource.data.vaultId == vaultId
          && isNonEmptyString(request.resource.data.inviteCode, 64)
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'accepted', 'rejected', 'expired', 'revoked']);
        allow update: if isMemberOfVault(vaultId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'updatedAt'])
          && request.resource.data.vaultId == resource.data.vaultId
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'accepted', 'rejected', 'expired', 'revoked']);
        allow delete: if false;
      }

      // Subcollection: contributions
      match /contributions/{contribId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isMemberOfVault(vaultId)
          && isValidId(contribId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.contributedByUid == request.auth.uid
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.status == 'active'
          && isIsoDate(request.resource.data.date)
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 256));
        allow update: if isMemberOfVault(vaultId)
          && resource.data.contributedByUid == request.auth.uid
          && request.resource.data.status == 'reversed'
          && request.resource.data.reversedByUid == request.auth.uid
          && request.resource.data.vaultId == resource.data.vaultId
          && request.resource.data.contributedByUid == resource.data.contributedByUid
          && request.resource.data.amountPaise == resource.data.amountPaise
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedByUid', 'reversalReason', 'reversedAt', 'updatedAt']);
        allow delete: if false;
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isMemberOfVault(vaultId)
          && isValidId(expenseId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.paidByUid == request.auth.uid
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.status == 'active'
          && isIsoDate(request.resource.data.date)
          && isNonEmptyString(request.resource.data.description, 256)
          && request.resource.data.splitMode in ['equal', 'custom', 'ratio'];
        allow update: if isMemberOfVault(vaultId)
          && request.resource.data.status == 'reversed'
          && request.resource.data.vaultId == resource.data.vaultId
          && request.resource.data.paidByUid == resource.data.paidByUid
          && request.resource.data.amountPaise == resource.data.amountPaise
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedByUid', 'reversalReason', 'reversedAt', 'updatedAt']);
        allow delete: if false;
      }

      // Subcollection: settlements
      match /settlements/{settleId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isMemberOfVault(vaultId)
          && isValidId(settleId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.fromUid == request.auth.uid
          && isPositivePaise(request.resource.data.amountPaise)
          && isNonEmptyString(request.resource.data.toUid, 128)
          && isIsoDate(request.resource.data.date);
        allow update, delete: if false;
      }

      // Subcollection: activity
      match /activity/{activityId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if (isMemberOfVault(vaultId) || (isSignedIn() && request.resource.data.actorUid == request.auth.uid))
          && isValidId(activityId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.actorUid == request.auth.uid
          && isNonEmptyString(request.resource.data.title, 128)
          && isIsoDate(request.resource.data.timestamp);
        allow update, delete: if false;
      }
    }
  }
}
