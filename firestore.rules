        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && isNonEmptyString(request.resource.data.name, 128);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // UNIVERSAL SHEET SYNC HUB & PRIVATE SHEETS
      // ==========================================
      // Assumed Data Models (User-Owned, Strictly Isolated):
      //   1. sheet_connections/{connectionId} - Connected Google Spreadsheet metadata (NO OAuth tokens)
      //   2. sheet_tabs/{tabId}               - Detected/confirmed tab schema & column mappings
      //   3. sheet_row_chunks/{chunkId}       - Byte-safe packed row chunks (<= 200 rows, <= 850 KB)
      //   4. sheet_sync_queue/{opId}          - Outbound cell mutation queue & retry state
      //   5. sheet_conflicts/{conflictId}     - 3-way merge conflict records & resolutions
      //   6. sheets/{sheetId}                 - Canonical Private Sheet Ownership Architecture
      //        -> tabs/{tabId}                - Nested tab schema and view definitions
      //        -> rows/{rowId}                - Granular row records
      //        -> row_chunks/{chunkId}        - Packed row chunks
      //
      // Security Invariants:
      //   - Strict Default-Deny Architecture: All access requires explicit scoped grant
      //   - Multi-User Isolation: Scoped strictly to /users/{userId}/ matching authenticated request.auth.uid
      //   - Immutable Ownership: userId and document id cannot be reassigned or spoofed
      //   - Field-Level Lockdown: Schema validation with hasOnly and strict type bounds
      //   - Zero Credential Leakage: OAuth access/refresh tokens are explicitly disallowed

      function isBoundedIsoDate(val) {
        return isIsoDate(val) && val.size() <= 64;
      }

      function isOptionalBoundedIsoDate(val) {
        return val == null || isBoundedIsoDate(val);
      }

      function isValidSheetScalar(val) {
        return val == null
          || val is bool
          || val is int
          || val is float
          || (val is string && val.size() <= 50000);
      }

      function isValidSheetDoc(data, docId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'title', 'spreadsheetId', 'spreadsheetUrl', 'description',
            'templateHint', 'syncMode', 'pollIntervalSec', 'syncOnOpen', 'status',
            'lastSyncedAt', 'lastSuccessfulPullAt', 'lastSuccessfulPushAt', 'lastError',
            'pendingChangesCount', 'conflictCount', 'tabOrder',
            'createdAt', 'updatedAt', 'deletedAt',
            'ownerUid', 'schemaVersion', 'sortOrder', 'isNative', 'isPublicLink',
            'writeMode', 'writeAuthStatus', 'writeAuthorizedAt',
            'isDualCopy', 'driveFileId', 'sourceSpreadsheetId', 'nativeSheetId',
            'lastDriveSyncAt', 'driveSyncStatus', 'lastDriveModifiedTime'
          ])
          && !('accessToken' in data)
          && !('refreshToken' in data)
          && data.id == docId
          && data.userId == uid
          && (data.get('ownerUid', null) == null || data.ownerUid == uid)
          && (data.get('schemaVersion', null) == null || isBoundedInt(data.schemaVersion, 1, 100))
          && (data.get('sortOrder', null) == null || isBoundedInt(data.sortOrder, 0, 100000))
          && (data.get('isNative', null) == null || data.isNative is bool)
          && (data.get('isPublicLink', null) == null || data.isPublicLink is bool)
          && (data.get('writeMode', null) == null || data.writeMode in ['native_oauth', 'apps_script', 'none'])
          && (data.get('writeAuthStatus', null) == null || data.writeAuthStatus in ['authorized', 'not_requested', 'expired', 'denied'])
          && isOptionalBoundedIsoDate(data.get('writeAuthorizedAt', null))
          && (data.get('isDualCopy', null) == null || data.isDualCopy is bool)
          && (data.get('driveFileId', null) == null || isNonEmptyString(data.driveFileId, 128))
          && (data.get('sourceSpreadsheetId', null) == null || isNonEmptyString(data.sourceSpreadsheetId, 128))
          && (data.get('nativeSheetId', null) == null || isNonEmptyString(data.nativeSheetId, 128))
          && isOptionalBoundedIsoDate(data.get('lastDriveSyncAt', null))
          && (data.get('driveSyncStatus', null) == null || data.driveSyncStatus in ['synced', 'pending', 'conflict', 'error', 'not_connected'])
          && isOptionalBoundedIsoDate(data.get('lastDriveModifiedTime', null))
          && isNonEmptyString(data.title, 256)
          && (data.get('spreadsheetId', null) == null || isNonEmptyString(data.spreadsheetId, 128))
          && (
            data.get('spreadsheetUrl', null) == null ||
            data.spreadsheetUrl == '' ||
            (
              isNonEmptyString(data.spreadsheetUrl, 1024)
              && (data.spreadsheetUrl.matches('^https://.*') || data.spreadsheetUrl.matches('^http://.*'))
            )
          )
          && isOptionalString(data.get('description', null), 2048)
          && (
            data.get('templateHint', null) == null ||
            data.templateHint in ['checklist', 'tracker', 'table', 'custom']
          )
          && data.syncMode in ['two_way', 'sheet_to_app', 'manual_only']
          && (
            data.get('pollIntervalSec', null) == null ||
            isBoundedInt(data.pollIntervalSec, 0, 86400)
          )
          && (data.get('syncOnOpen', null) == null || data.syncOnOpen is bool)
          && data.status in ['active', 'paused', 'auth_required', 'error']
          && isOptionalBoundedIsoDate(data.get('lastSyncedAt', null))
          && isOptionalBoundedIsoDate(data.get('lastSuccessfulPullAt', null))
          && isOptionalBoundedIsoDate(data.get('lastSuccessfulPushAt', null))
          && isOptionalString(data.get('lastError', null), 2048)
          && (
            data.get('pendingChangesCount', null) == null ||
            isBoundedInt(data.pendingChangesCount, 0, 100000)
          )
          && (
            data.get('conflictCount', null) == null ||
            isBoundedInt(data.conflictCount, 0, 100000)
          )
          && (
            data.get('tabOrder', null) == null ||
            (data.tabOrder is list && data.tabOrder.size() <= 100)
          )
          && isBoundedIsoDate(data.createdAt)
          && isBoundedIsoDate(data.updatedAt)
          && isOptionalBoundedIsoDate(data.get('deletedAt', null));
      }

      function isValidNestedSheetTab(data, docId, uid, sheetDocId) {
        return data.keys().hasOnly([
            'id', 'sheetDocId', 'sheetId', 'connectionId', 'userId', 'title', 'sheetTitle',
            'role', 'headerRowIndex', 'dataStartRow', 'dataEndColumn', 'identityStrategy',
            'identityColumns', 'metadataIdColumn', 'columns', 'defaultView',
            'groupByColumnId', 'lastPullHash', 'rowCount', 'chunkCount', 'createdAt', 'updatedAt',
            'ownerUid', 'position'
          ])
          && !('accessToken' in data)
          && !('refreshToken' in data)
          && data.id == docId
          && data.userId == uid
          && (data.get('ownerUid', null) == null || data.ownerUid == uid)
          && (data.get('position', null) == null || isBoundedInt(data.position, 0, 1000))
          && (data.get('sheetDocId', null) == null || data.sheetDocId == sheetDocId)
          && (data.get('connectionId', null) == null || data.connectionId == sheetDocId || isValidId(data.connectionId))
          && (data.get('sheetId', null) == null || isBoundedInt(data.sheetId, 0, 2147483647) || isValidId(data.sheetId))
          && isNonEmptyString(data.get('sheetTitle', data.get('title', '')), 256)
          && data.role in ['data', 'overview', 'ignored']
          && (data.get('headerRowIndex', null) == null || isBoundedInt(data.headerRowIndex, 0, 100))
          && (data.get('dataStartRow', null) == null || isBoundedInt(data.dataStartRow, 1, 1000))
          && isOptionalString(data.get('dataEndColumn', null), 16)
          && (data.get('identityStrategy', null) == null || data.identityStrategy in ['column_key', 'composite_key', 'metadata_column'])
          && (data.get('identityColumns', null) == null || (data.identityColumns is list && data.identityColumns.size() <= 10))
          && isOptionalString(data.get('metadataIdColumn', null), 64)
          && (data.get('columns', null) == null || (data.columns is list && data.columns.size() <= 100))
          && (data.get('defaultView', null) == null || data.defaultView in ['checklist', 'table', 'grouped_list'])
          && isOptionalString(data.get('groupByColumnId', null), 128)
          && isOptionalString(data.get('lastPullHash', null), 128)
          && (data.get('rowCount', null) == null || isBoundedInt(data.rowCount, 0, 100000))
          && (data.get('chunkCount', null) == null || isBoundedInt(data.chunkCount, 0, 10000))
          && isBoundedIsoDate(data.updatedAt)
          && isOptionalBoundedIsoDate(data.get('createdAt', null));
      }

      function isValidSheetRow(data, docId, uid, sheetDocId, parentTabId) {
        return data.keys().hasOnly([
            'id', 'sheetDocId', 'sheetId', 'tabId', 'userId', 'rowUid',
            'lastKnownSheetRow', 'values', 'baseValues', 'rowHash', 'version',
            'lastSyncOrigin', 'dirtyFields', 'localUpdatedAt', 'sheetSyncedAt',
            'status', 'createdAt', 'updatedAt', 'deletedAt',
            'ownerUid', 'rowIndex', 'cells'
          ])
          && !('accessToken' in data)
          && !('refreshToken' in data)
          && data.id == docId
          && data.userId == uid
          && (data.get('ownerUid', null) == null || data.ownerUid == uid)
          && (data.get('rowIndex', null) == null || isBoundedInt(data.rowIndex, 0, 100000))
          && (data.get('cells', null) == null || (data.cells is map && data.cells.size() <= 200))
          && (data.get('sheetDocId', null) == null || data.sheetDocId == sheetDocId)
          && (data.get('sheetId', null) == null || data.sheetId == sheetDocId || isValidId(data.sheetId))
          && (
            parentTabId == null
              ? (data.get('tabId', null) == null || isValidId(data.tabId))
              : (data.get('tabId', null) == null || data.tabId == parentTabId)
          )
          && (data.get('rowUid', null) == null || isNonEmptyString(data.rowUid, 128))
          && (data.get('lastKnownSheetRow', null) == null || isBoundedInt(data.lastKnownSheetRow, 0, 100000))
          && (data.get('values', null) == null || (data.values is map && data.values.size() <= 200))
          && (data.get('baseValues', null) == null || (data.baseValues is map && data.baseValues.size() <= 200))
          && isOptionalString(data.get('rowHash', null), 128)
          && (data.get('version', null) == null || isBoundedInt(data.version, 0, 1000000))
          && (data.get('lastSyncOrigin', null) == null || data.lastSyncOrigin in ['sheet', 'app'])
          && (data.get('dirtyFields', null) == null || (data.dirtyFields is list && data.dirtyFields.size() <= 100))
          && isOptionalBoundedIsoDate(data.get('localUpdatedAt', null))
          && isOptionalBoundedIsoDate(data.get('sheetSyncedAt', null))
          && (data.get('status', null) == null || data.status in ['synced', 'pending_push', 'conflict', 'missing_in_sheet'])
          && isOptionalBoundedIsoDate(data.get('createdAt', null))
          && isOptionalBoundedIsoDate(data.get('updatedAt', null))
          && (('updatedAt' in data) || ('createdAt' in data))
          && isOptionalBoundedIsoDate(data.get('deletedAt', null));
      }

      function isValidNestedSheetRowChunk(data, docId, uid, sheetDocId, parentTabId) {
        return data.keys().hasOnly([
            'id', 'sheetDocId', 'sheetId', 'connectionId', 'tabId', 'userId',
            'chunkIndex', 'rowCount', 'byteSize', 'rows', 'createdAt', 'updatedAt'
          ])
          && !('accessToken' in data)
          && !('refreshToken' in data)
          && data.id == docId
          && data.userId == uid
          && (data.get('sheetDocId', null) == null || data.sheetDocId == sheetDocId)
          && (data.get('sheetId', null) == null || data.sheetId == sheetDocId || isValidId(data.sheetId))
          && (data.get('connectionId', null) == null || data.connectionId == sheetDocId || isValidId(data.connectionId))
          && (
            parentTabId == null
              ? (data.get('tabId', null) == null || isValidId(data.tabId))
              : (data.get('tabId', null) == null || data.tabId == parentTabId)
          )
          && isBoundedInt(data.chunkIndex, 0, 10000)
          && isBoundedInt(data.rowCount, 0, 200)
          && isBoundedInt(data.byteSize, 0, 850000)
          && data.rows is map
          && data.rows.size() <= 200
          && isBoundedIsoDate(data.updatedAt)
          && isOptionalBoundedIsoDate(data.get('createdAt', null));
      }

      // 1. Sheet connections subcollection (Universal Sheet Sync Hub)
      match /sheet_connections/{connectionId} {
        function isValidSheetConnection(data, docId, uid) {
          return data.keys().hasOnly([
              'id', 'userId', 'spreadsheetId', 'spreadsheetUrl', 'title', 'description',
              'templateHint', 'syncMode', 'pollIntervalSec', 'syncOnOpen',
              'status', 'lastSyncedAt', 'lastSuccessfulPullAt', 'lastSuccessfulPushAt',
              'lastError', 'pendingChangesCount', 'conflictCount', 'tabOrder',
              'createdAt', 'updatedAt', 'deletedAt',
              'ownerUid', 'schemaVersion', 'sortOrder', 'isNative', 'isPublicLink',
              'writeMode', 'writeAuthStatus', 'writeAuthorizedAt',
              'isDualCopy', 'driveFileId', 'sourceSpreadsheetId', 'nativeSheetId',
              'lastDriveSyncAt', 'driveSyncStatus', 'lastDriveModifiedTime'
            ])
            && !('accessToken' in data)
            && !('refreshToken' in data)
            && data.id == docId
            && data.userId == uid
            && (data.get('ownerUid', null) == null || data.ownerUid == uid)
            && (data.get('schemaVersion', null) == null || isBoundedInt(data.schemaVersion, 1, 100))
            && (data.get('sortOrder', null) == null || isBoundedInt(data.sortOrder, 0, 100000))
            && (data.get('isNative', null) == null || data.isNative is bool)
            && (data.get('isPublicLink', null) == null || data.isPublicLink is bool)
            && (data.get('writeMode', null) == null || data.writeMode in ['native_oauth', 'apps_script', 'none'])
            && (data.get('writeAuthStatus', null) == null || data.writeAuthStatus in ['authorized', 'not_requested', 'expired', 'denied'])
            && isOptionalBoundedIsoDate(data.get('writeAuthorizedAt', null))
            && (data.get('isDualCopy', null) == null || data.isDualCopy is bool)
            && (data.get('driveFileId', null) == null || isNonEmptyString(data.driveFileId, 128))
            && (data.get('sourceSpreadsheetId', null) == null || isNonEmptyString(data.sourceSpreadsheetId, 128))
            && (data.get('nativeSheetId', null) == null || isNonEmptyString(data.nativeSheetId, 128))
            && isOptionalBoundedIsoDate(data.get('lastDriveSyncAt', null))
            && (data.get('driveSyncStatus', null) == null || data.driveSyncStatus in ['synced', 'pending', 'conflict', 'error', 'not_connected'])
            && isOptionalBoundedIsoDate(data.get('lastDriveModifiedTime', null))
            && isNonEmptyString(data.spreadsheetId, 128)
            && (
              (data.get('isNative', false) == true && (data.get('spreadsheetUrl', null) == null || data.spreadsheetUrl == '')) ||
              (
                isNonEmptyString(data.spreadsheetUrl, 1024)
                && (data.spreadsheetUrl.matches('^https://.*') || data.spreadsheetUrl.matches('^http://.*'))
              )
            )
            && isNonEmptyString(data.title, 256)
            && isOptionalString(data.get('description', null), 2048)
            && (
              data.get('templateHint', null) == null ||
              data.templateHint in ['checklist', 'tracker', 'table', 'custom']
            )
            && data.syncMode in ['two_way', 'sheet_to_app', 'manual_only']
            && (
              data.get('pollIntervalSec', null) == null ||
              isBoundedInt(data.pollIntervalSec, 0, 86400)
            )
            && data.syncOnOpen is bool
            && data.status in ['active', 'paused', 'auth_required', 'error']
            && isOptionalBoundedIsoDate(data.get('lastSyncedAt', null))
            && isOptionalBoundedIsoDate(data.get('lastSuccessfulPullAt', null))
            && isOptionalBoundedIsoDate(data.get('lastSuccessfulPushAt', null))
            && isOptionalString(data.get('lastError', null), 2048)
            && isBoundedInt(data.pendingChangesCount, 0, 100000)
            && isBoundedInt(data.conflictCount, 0, 100000)
            && data.tabOrder is list
            && data.tabOrder.size() <= 100
            && isBoundedIsoDate(data.createdAt)
            && isBoundedIsoDate(data.updatedAt)
            && isOptionalBoundedIsoDate(data.get('deletedAt', null));
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(connectionId)
          && isValidSheetConnection(request.resource.data, connectionId, userId);
        allow update: if isOwner(userId)
          && isValidSheetConnection(request.resource.data, connectionId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.spreadsheetId == resource.data.spreadsheetId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // 2. Sheet tabs subcollection (Universal Sheet Sync Hub)
      match /sheet_tabs/{tabId} {
        function isValidSheetTab(data, docId, uid) {
          return data.keys().hasOnly([
              'id', 'connectionId', 'sheetDocId', 'userId', 'ownerUid', 'sheetId', 'sheetTitle',
              'position', 'role', 'headerRowIndex', 'dataStartRow', 'dataEndColumn', 'identityStrategy',
              'identityColumns', 'metadataIdColumn', 'columns', 'defaultView',
              'groupByColumnId', 'lastPullHash', 'rowCount', 'chunkCount', 'createdAt', 'updatedAt'
            ])
            && !('accessToken' in data)
            && !('refreshToken' in data)
            && data.id == docId
            && data.userId == uid
            && (data.get('ownerUid', null) == null || data.ownerUid == uid)
            && (data.get('sheetDocId', null) == null || isValidId(data.sheetDocId))
            && (data.get('position', null) == null || isBoundedInt(data.position, 0, 1000))
            && isValidId(data.connectionId)
            && isBoundedInt(data.sheetId, 0, 2147483647)
            && isNonEmptyString(data.sheetTitle, 256)
            && data.role in ['data', 'overview', 'ignored']
            && isBoundedInt(data.headerRowIndex, 0, 100)
            && isBoundedInt(data.dataStartRow, 0, 1000)
            && isOptionalString(data.get('dataEndColumn', null), 16)
            && data.identityStrategy in ['column_key', 'composite_key', 'metadata_column']
            && data.identityColumns is list
            && data.identityColumns.size() <= 10
            && isOptionalString(data.get('metadataIdColumn', null), 64)
            && data.columns is list
            && data.columns.size() <= 100
            && data.defaultView in ['checklist', 'table', 'grouped_list']
            && isOptionalString(data.get('groupByColumnId', null), 128)
            && isOptionalString(data.get('lastPullHash', null), 128)
            && isBoundedInt(data.rowCount, 0, 100000)
            && (
              data.get('chunkCount', null) == null ||
              isBoundedInt(data.chunkCount, 0, 10000)
            )
            && isBoundedIsoDate(data.updatedAt)
            && isOptionalBoundedIsoDate(data.get('createdAt', null));
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(tabId)
          && isValidSheetTab(request.resource.data, tabId, userId);
        allow update: if isOwner(userId)
          && isValidSheetTab(request.resource.data, tabId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.connectionId == resource.data.connectionId
          && request.resource.data.sheetId == resource.data.sheetId;
        allow delete: if isOwner(userId);
      }

      // 3. Sheet row chunks subcollection (Universal Sheet Sync Hub)
      match /sheet_row_chunks/{chunkId} {
        function isValidSheetRowChunk(data, docId, uid) {
          return data.keys().hasOnly([
              'id', 'connectionId', 'tabId', 'userId', 'chunkIndex',
              'rowCount', 'byteSize', 'rows', 'updatedAt'
            ])
            && !('accessToken' in data)
            && !('refreshToken' in data)
            && data.id == docId
            && data.userId == uid
            && isValidId(data.connectionId)
            && isValidId(data.tabId)
            && isBoundedInt(data.chunkIndex, 0, 10000)
            && isBoundedInt(data.rowCount, 0, 200)
            && isBoundedInt(data.byteSize, 0, 850000)
            && data.rows is map
            && data.rows.size() <= 200
            && isBoundedIsoDate(data.updatedAt);
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(chunkId)
          && isValidSheetRowChunk(request.resource.data, chunkId, userId);
        allow update: if isOwner(userId)
          && isValidSheetRowChunk(request.resource.data, chunkId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.connectionId == resource.data.connectionId
          && request.resource.data.tabId == resource.data.tabId
          && request.resource.data.chunkIndex == resource.data.chunkIndex;
        allow delete: if isOwner(userId);
      }

      // 4. Sheet sync queue subcollection (Universal Sheet Sync Hub)
      match /sheet_sync_queue/{opId} {
        function isValidSheetSyncOp(data, docId, uid) {
          return data.keys().hasOnly([
              'id', 'connectionId', 'tabId', 'userId', 'rowUid', 'colLetter',
              'fieldKey', 'baseValue', 'nextValue', 'dedupeKey', 'status',
              'attempts', 'nextRetryAt', 'errorMessage', 'createdAt', 'lastAttemptAt'
            ])
            && !('accessToken' in data)
            && !('refreshToken' in data)
            && data.id == docId
            && data.userId == uid
            && isValidId(data.connectionId)
            && isValidId(data.tabId)
            && isNonEmptyString(data.rowUid, 128)
            && isOptionalString(data.get('colLetter', null), 16)
            && isOptionalString(data.get('fieldKey', null), 128)
            && isValidSheetScalar(data.get('baseValue', null))
            && isValidSheetScalar(data.get('nextValue', null))
            && isNonEmptyString(data.dedupeKey, 256)
            && data.status in ['pending', 'syncing', 'completed', 'failed', 'conflict']
            && isBoundedInt(data.attempts, 0, 20)
            && (
              data.get('nextRetryAt', null) == null ||
              isBoundedInt(data.nextRetryAt, 0, 4102444800000)
            )
            && isOptionalString(data.get('errorMessage', null), 2048)
            && isBoundedIsoDate(data.createdAt)
            && isOptionalBoundedIsoDate(data.get('lastAttemptAt', null));
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(opId)
          && isValidSheetSyncOp(request.resource.data, opId, userId);
        allow update: if isOwner(userId)
          && isValidSheetSyncOp(request.resource.data, opId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.connectionId == resource.data.connectionId
          && request.resource.data.tabId == resource.data.tabId
          && request.resource.data.rowUid == resource.data.rowUid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // 5. Sheet conflicts subcollection (Universal Sheet Sync Hub)
      match /sheet_conflicts/{conflictId} {
        function isValidSheetConflict(data, docId, uid) {
          return data.keys().hasOnly([
              'id', 'connectionId', 'tabId', 'userId', 'rowUid', 'fieldKey',
              'fieldLabel', 'baseValue', 'localValue', 'remoteValue', 'status',
              'resolution', 'detectedAt', 'resolvedAt'
            ])
            && !('accessToken' in data)
            && !('refreshToken' in data)
            && data.id == docId
            && data.userId == uid
            && isValidId(data.connectionId)
            && isValidId(data.tabId)
            && isNonEmptyString(data.rowUid, 128)
            && isNonEmptyString(data.fieldKey, 128)
            && isOptionalString(data.get('fieldLabel', null), 256)
            && isValidSheetScalar(data.get('baseValue', null))
            && isValidSheetScalar(data.get('localValue', null))
            && isValidSheetScalar(data.get('remoteValue', null))
            && data.status in ['open', 'resolved']
            && (
              data.get('resolution', null) == null ||
              data.resolution in ['keep_app', 'keep_sheet', 'custom']
            )
            && isBoundedIsoDate(data.detectedAt)
            && isOptionalBoundedIsoDate(data.get('resolvedAt', null));
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(conflictId)
          && isValidSheetConflict(request.resource.data, conflictId, userId);
        allow update: if isOwner(userId)
          && isValidSheetConflict(request.resource.data, conflictId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.connectionId == resource.data.connectionId
          && request.resource.data.tabId == resource.data.tabId
          && request.resource.data.rowUid == resource.data.rowUid
          && request.resource.data.fieldKey == resource.data.fieldKey
          && request.resource.data.detectedAt == resource.data.detectedAt;
        allow delete: if isOwner(userId);
      }

      // 6. Canonical Private Sheet Ownership Architecture
      // match /users/{userId}/sheets/{sheetId}
      match /sheets/{sheetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(sheetId)
          && request.resource.data.userId == userId
          && request.resource.data.id == sheetId
          && isValidSheetDoc(request.resource.data, sheetId, userId);
        allow update: if isOwner(userId)
          && isValidSheetDoc(request.resource.data, sheetId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            !('spreadsheetId' in resource.data) ||
            request.resource.data.get('spreadsheetId', null) == resource.data.spreadsheetId
          );
        allow delete: if isOwner(userId);

        // Subcollection tabs under sheets/{sheetId}/tabs/{tabId}
        match /tabs/{tabId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(tabId)
            && request.resource.data.id == tabId
            && request.resource.data.userId == userId
            && isValidNestedSheetTab(request.resource.data, tabId, userId, sheetId);
          allow update: if isOwner(userId)
            && isValidNestedSheetTab(request.resource.data, tabId, userId, sheetId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && (!('sheetDocId' in resource.data) || request.resource.data.sheetDocId == resource.data.sheetDocId)
            && (!('connectionId' in resource.data) || request.resource.data.connectionId == resource.data.connectionId)
            && (!('sheetId' in resource.data) || request.resource.data.sheetId == resource.data.sheetId)
            && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
          allow delete: if isOwner(userId);

          // Subcollection rows under tab: sheets/{sheetId}/tabs/{tabId}/rows/{rowId}
          match /rows/{rowId} {
            allow read: if isOwner(userId);
            allow create: if isOwner(userId)
              && isValidId(rowId)
              && request.resource.data.id == rowId
              && request.resource.data.userId == userId
              && isValidSheetRow(request.resource.data, rowId, userId, sheetId, tabId);
            allow update: if isOwner(userId)
              && isValidSheetRow(request.resource.data, rowId, userId, sheetId, tabId)
              && request.resource.data.id == resource.data.id
              && request.resource.data.userId == resource.data.userId
              && (!('sheetDocId' in resource.data) || request.resource.data.sheetDocId == resource.data.sheetDocId)
              && (!('tabId' in resource.data) || request.resource.data.tabId == resource.data.tabId)
              && (!('rowUid' in resource.data) || request.resource.data.rowUid == resource.data.rowUid)
              && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
            allow delete: if isOwner(userId);
          }

          // Subcollection row_chunks under tab: sheets/{sheetId}/tabs/{tabId}/row_chunks/{chunkId}
          match /row_chunks/{chunkId} {
            allow read: if isOwner(userId);
            allow create: if isOwner(userId)
              && isValidId(chunkId)
              && request.resource.data.id == chunkId
              && request.resource.data.userId == userId
              && isValidNestedSheetRowChunk(request.resource.data, chunkId, userId, sheetId, tabId);
            allow update: if isOwner(userId)
              && isValidNestedSheetRowChunk(request.resource.data, chunkId, userId, sheetId, tabId)
              && request.resource.data.id == resource.data.id
              && request.resource.data.userId == resource.data.userId
              && (!('sheetDocId' in resource.data) || request.resource.data.sheetDocId == resource.data.sheetDocId)
              && request.resource.data.tabId == resource.data.tabId
              && request.resource.data.chunkIndex == resource.data.chunkIndex
              && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
            allow delete: if isOwner(userId);
          }
        }

        // Subcollection rows directly under sheet: sheets/{sheetId}/rows/{rowId}
        match /rows/{rowId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(rowId)
            && request.resource.data.id == rowId
            && request.resource.data.userId == userId
            && isValidSheetRow(request.resource.data, rowId, userId, sheetId, null);
          allow update: if isOwner(userId)
            && isValidSheetRow(request.resource.data, rowId, userId, sheetId, null)
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && (!('sheetDocId' in resource.data) || request.resource.data.sheetDocId == resource.data.sheetDocId)
            && (!('tabId' in resource.data) || request.resource.data.tabId == resource.data.tabId)
            && (!('rowUid' in resource.data) || request.resource.data.rowUid == resource.data.rowUid)
            && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
          allow delete: if isOwner(userId);
        }

        // Subcollection row_chunks directly under sheet: sheets/{sheetId}/row_chunks/{chunkId}
        match /row_chunks/{chunkId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(chunkId)
            && request.resource.data.id == chunkId
            && request.resource.data.userId == userId
            && isValidNestedSheetRowChunk(request.resource.data, chunkId, userId, sheetId, null);
          allow update: if isOwner(userId)
            && isValidNestedSheetRowChunk(request.resource.data, chunkId, userId, sheetId, null)
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && (!('sheetDocId' in resource.data) || request.resource.data.sheetDocId == resource.data.sheetDocId)
            && (!('tabId' in resource.data) || request.resource.data.tabId == resource.data.tabId)
            && request.resource.data.chunkIndex == resource.data.chunkIndex
            && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
          allow delete: if isOwner(userId);
        }
      }

      // ===============================================================
      // V1.8.0 ZERO-AI FEATURE SUITE (8 USER-OWNED SUBCOLLECTIONS)
      // ===============================================================
      // Assumed Data Models (Hardware-Enforced Tenant Isolation):
      //
      // 1. users/{userId}/skill_nodes/{nodeId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - trackId: optional string (1..128)
      //    - title: string (1..128)
      //    - description: optional string (<= 1000)
      //    - tier: integer (1..10)
      //    - prerequisites: optional list of string node IDs (<= 50)
      //    - status: 'locked' | 'available' | 'in_progress' | 'completed'
      //    - category: optional string (1..64)
      //    - xpPoints: number (0..100000)
      //    - completedAt: optional ISO date string or null (<= 64)
      //    - notes: optional string (<= 2000)
      //    - icon: optional string (<= 64)
      //    - position: optional map (<= 4 keys)
      //    - estimatedHours: optional number (0..10000)
      //    - tags: optional list of strings (<= 20)
      //    - createdAt: optional ISO date string (<= 64) [immutable]
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 2. users/{userId}/whiteboard_drawings/{drawingId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - title: string (1..128)
      //    - topicId: optional string (<= 128)
      //    - topicTitle: optional string (<= 128)
      //    - dataUrl: string (data:image/... base64, 1..2097152 bytes)
      //    - sizeBytes: number (0..10485760)
      //    - width: integer (1..4096)
      //    - height: integer (1..4096)
      //    - createdAt: ISO date string (1..64) [immutable]
      //    - updatedAt: ISO date string (1..64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 3. users/{userId}/exam_simulations/{simId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - title: string (1..128)
      //    - totalDurationMinutes: integer (1..1440)
      //    - sections: list of exam sections (<= 20)
      //    - currentSectionIndex: integer (0..100)
      //    - status: 'idle' | 'running' | 'paused' | 'completed' | 'in_progress'
      //    - sectionElapsedSeconds: map of elapsed seconds per section (<= 50)
      //    - totalElapsedSeconds: integer (0..86400)
      //    - flaggedQuestions: optional map (<= 50)
      //    - attemptedQuestions: optional map (<= 50)
      //    - startedAt: optional ISO date string (<= 64)
      //    - completedAt: optional ISO date string (<= 64)
      //    - createdAt: optional ISO date string (<= 64) [immutable]
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 4. users/{userId}/decision_entries/{entryId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - title: string (1..256)
      //    - category: 'career' | 'academic' | 'financial' | 'personal' | 'health'
      //    - rationale: optional string (<= 2000)
      //    - expectedOutcome: optional string (<= 2000)
      //    - confidenceScore: integer (1..10)
      //    - expectedReviewDate: string (1..32)
      //    - reviewIntervalDays: integer (1..3650)
      //    - status: 'pending_review' | 'reviewed'
      //    - actualOutcome: optional string (<= 2000)
      //    - successRating: optional integer (1..5) or null
      //    - reflection: optional string (<= 2000)
      //    - lessonsLearned: optional string (<= 2000)
      //    - createdAt: ISO date string (1..64) [immutable]
      //    - reviewedAt: optional ISO date string (<= 64)
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 5. users/{userId}/doomscroll_logs/{logId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - minutes: integer (1..1440)
      //    - durationMinutes: optional integer (1..1440)
      //    - distractionApp: string (1..64)
      //    - platform: optional string (<= 64)
      //    - ratePerHour: number (0..1000000)
      //    - amountTaxed: number (0..100000000)
      //    - taxAmountPaise: optional number (0..10000000000)
      //    - currency: string (1..8)
      //    - notes: optional string (<= 500)
      //    - reason: optional string (<= 500)
      //    - linkedSavingsGoalId: optional string (<= 128)
      //    - createdAt: ISO date string (1..64) [immutable]
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 6. users/{userId}/life_milestones/{milestoneId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - weekIndex: integer (0..6000)
      //    - age: number (0..120)
      //    - label: optional string (<= 128) [either label or title present]
      //    - title: optional string (<= 128)
      //    - category: 'education' | 'career' | 'personal' | 'health' | 'target'
      //    - date: optional string (<= 64)
      //    - color: optional string (<= 32)
      //    - createdAt: optional ISO date string (<= 64) [immutable]
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 7. users/{userId}/time_capsules/{capsuleId}
      //    - id: string (doc ID, 1..128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - title: string (1..256)
      //    - content: string (1..20000)
      //    - unlockDate: string (1..32)
      //    - isUnlocked: boolean
      //    - isSealed: optional boolean
      //    - sealedAt: optional ISO date string (<= 64)
      //    - openedAt: optional ISO date string (<= 64)
      //    - tags: optional list of strings (<= 20)
      //    - createdAt: ISO date string (1..64) [immutable]
      //    - updatedAt: optional ISO date string (<= 64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      //
      // 8. users/{userId}/emergency_profile/{profileId}
      //    - id: optional string (<= 128) [immutable]
      //    - userId: string (== userId) [immutable]
      //    - fullName: optional string (<= 128)
      //    - bloodGroup: optional string (<= 16)
      //    - primaryHospital: optional string (<= 256)
      //    - accounts: list of masked accounts (<= 50)
      //    - policies: list of insurance policies (<= 50)
      //    - emergencyContacts: optional list of contacts (<= 20)
      //    - contacts: optional list of contacts (<= 20)
      //    - importantDocumentLocations: optional string (<= 2000)
      //    - instructionsNote: optional string (<= 2000)
      //    - notes: optional string (<= 2000)
      //    - createdAt: optional ISO date string (<= 64) [immutable]
      //    - updatedAt: ISO date string (1..64)
      //    - deletedAt: optional ISO date string or null (<= 64)
      // ===============================================================

      function isValidSkillNode(data, nodeId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'trackId', 'title', 'description', 'tier',
            'prerequisites', 'status', 'category', 'xpPoints', 'completedAt',
            'notes', 'icon', 'position', 'estimatedHours', 'tags',
            'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == nodeId)
          && isNonEmptyString(data.title, 128)
          && (!('trackId' in data) || isNonEmptyString(data.trackId, 128))
          && isBoundedInt(data.tier, 1, 10)
          && (data.status in ['locked', 'available', 'in_progress', 'completed'])
          && ((data.xpPoints is int || data.xpPoints is float) && data.xpPoints >= 0 && data.xpPoints <= 100000)
          && (!('category' in data) || isNonEmptyString(data.category, 64))
          && (!('prerequisites' in data) || (data.prerequisites is list && data.prerequisites.size() <= 50))
          && (!('description' in data) || isOptionalString(data.description, 1000))
          && (!('completedAt' in data) || data.completedAt == null || (data.completedAt is string && data.completedAt.size() <= 64))
          && (!('notes' in data) || isOptionalString(data.notes, 2000))
          && (!('icon' in data) || isOptionalString(data.icon, 64))
          && (!('position' in data) || (data.position is map && data.position.size() <= 4))
          && (!('estimatedHours' in data) || ((data.estimatedHours is int || data.estimatedHours is float) && data.estimatedHours >= 0 && data.estimatedHours <= 10000))
          && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
          && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidWhiteboardDrawing(data, drawingId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'title', 'topicId', 'topicTitle',
            'dataUrl', 'sizeBytes', 'width', 'height',
            'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == drawingId)
          && isNonEmptyString(data.title, 128)
          && (data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 2097152)
          && ((data.sizeBytes is int || data.sizeBytes is float) && data.sizeBytes >= 0 && data.sizeBytes <= 10485760)
          && isBoundedInt(data.width, 1, 4096)
          && isBoundedInt(data.height, 1, 4096)
          && (!('topicId' in data) || isOptionalString(data.topicId, 128))
          && (!('topicTitle' in data) || isOptionalString(data.topicTitle, 128))
          && isNonEmptyString(data.createdAt, 64)
          && isNonEmptyString(data.updatedAt, 64)
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidExamSimulation(data, simId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'title', 'totalDurationMinutes', 'sections',
            'currentSectionIndex', 'status', 'sectionElapsedSeconds',
            'totalElapsedSeconds', 'flaggedQuestions', 'attemptedQuestions',
            'startedAt', 'completedAt', 'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == simId)
          && isNonEmptyString(data.title, 128)
          && isBoundedInt(data.totalDurationMinutes, 1, 1440)
          && (data.status in ['idle', 'running', 'paused', 'completed', 'in_progress'])
          && (data.sections is list && data.sections.size() <= 20)
          && isBoundedInt(data.currentSectionIndex, 0, 100)
          && isBoundedInt(data.totalElapsedSeconds, 0, 86400)
          && (data.sectionElapsedSeconds is map && data.sectionElapsedSeconds.size() <= 50)
          && (!('flaggedQuestions' in data) || (data.flaggedQuestions is map && data.flaggedQuestions.size() <= 50))
          && (!('attemptedQuestions' in data) || (data.attemptedQuestions is map && data.attemptedQuestions.size() <= 50))
          && (!('startedAt' in data) || isOptionalString(data.startedAt, 64))
          && (!('completedAt' in data) || isOptionalString(data.completedAt, 64))
          && (!('createdAt' in data) || isOptionalString(data.createdAt, 64))
          && (!('updatedAt' in data) || isOptionalString(data.updatedAt, 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidDecisionEntry(data, entryId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'title', 'category', 'rationale', 'expectedOutcome',
            'confidenceScore', 'expectedReviewDate', 'reviewIntervalDays', 'status',
            'actualOutcome', 'successRating', 'reflection', 'lessonsLearned',
            'createdAt', 'reviewedAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == entryId)
          && isNonEmptyString(data.title, 256)
          && (data.category in ['career', 'academic', 'financial', 'personal', 'health'])
          && isBoundedInt(data.confidenceScore, 1, 10)
          && isNonEmptyString(data.expectedReviewDate, 32)
          && isBoundedInt(data.reviewIntervalDays, 1, 3650)
          && (data.status in ['pending_review', 'reviewed'])
          && (!('rationale' in data) || isOptionalString(data.rationale, 2000))
          && (!('expectedOutcome' in data) || isOptionalString(data.expectedOutcome, 2000))
          && (!('actualOutcome' in data) || isOptionalString(data.actualOutcome, 2000))
          && (!('successRating' in data) || data.successRating == null || isBoundedInt(data.successRating, 1, 5))
          && (!('reflection' in data) || isOptionalString(data.reflection, 2000))
          && (!('lessonsLearned' in data) || isOptionalString(data.lessonsLearned, 2000))
          && isNonEmptyString(data.createdAt, 64)
          && (!('reviewedAt' in data) || isOptionalString(data.reviewedAt, 64))
          && (!('updatedAt' in data) || isOptionalString(data.updatedAt, 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidDoomscrollLog(data, logId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'minutes', 'durationMinutes', 'distractionApp',
            'platform', 'ratePerHour', 'amountTaxed', 'taxAmountPaise',
            'currency', 'notes', 'reason', 'linkedSavingsGoalId',
            'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == logId)
          && isBoundedInt(data.minutes, 1, 1440)
          && isNonEmptyString(data.distractionApp, 64)
          && ((data.ratePerHour is int || data.ratePerHour is float) && data.ratePerHour >= 0 && data.ratePerHour <= 1000000)
          && ((data.amountTaxed is int || data.amountTaxed is float) && data.amountTaxed >= 0 && data.amountTaxed <= 100000000)
          && isNonEmptyString(data.currency, 8)
          && isNonEmptyString(data.createdAt, 64)
          && (!('durationMinutes' in data) || isBoundedInt(data.durationMinutes, 1, 1440))
          && (!('platform' in data) || isOptionalString(data.platform, 64))
          && (!('taxAmountPaise' in data) || ((data.taxAmountPaise is int || data.taxAmountPaise is float) && data.taxAmountPaise >= 0 && data.taxAmountPaise <= 10000000000))
          && (!('notes' in data) || isOptionalString(data.notes, 500))
          && (!('reason' in data) || isOptionalString(data.reason, 500))
          && (!('linkedSavingsGoalId' in data) || isOptionalString(data.linkedSavingsGoalId, 128))
          && (!('updatedAt' in data) || isOptionalString(data.updatedAt, 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidLifeMilestone(data, milestoneId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'weekIndex', 'age', 'label', 'title',
            'category', 'date', 'color', 'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == milestoneId)
          && isBoundedInt(data.weekIndex, 0, 6000)
          && ((data.age is int || data.age is float) && data.age >= 0 && data.age <= 120)
          && (data.category in ['education', 'career', 'personal', 'health', 'target'])
          && (
            ('label' in data && isNonEmptyString(data.label, 128)) ||
            ('title' in data && isNonEmptyString(data.title, 128))
          )
          && (!('label' in data) || isOptionalString(data.label, 128))
          && (!('title' in data) || isOptionalString(data.title, 128))
          && (!('date' in data) || isOptionalString(data.date, 64))
          && (!('color' in data) || isOptionalString(data.color, 32))
          && (!('createdAt' in data) || isOptionalString(data.createdAt, 64))
          && (!('updatedAt' in data) || isOptionalString(data.updatedAt, 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidTimeCapsule(data, capsuleId, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'title', 'content', 'createdAt', 'unlockDate',
            'isUnlocked', 'isSealed', 'sealedAt', 'openedAt', 'tags',
            'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || data.id == capsuleId)
          && isNonEmptyString(data.title, 256)
          && isNonEmptyString(data.content, 20000)
          && isNonEmptyString(data.unlockDate, 32)
          && data.isUnlocked is bool
          && isNonEmptyString(data.createdAt, 64)
          && (!('isSealed' in data) || data.isSealed is bool)
          && (!('sealedAt' in data) || isOptionalString(data.sealedAt, 64))
          && (!('openedAt' in data) || isOptionalString(data.openedAt, 64))
          && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
          && (!('updatedAt' in data) || isOptionalString(data.updatedAt, 64))
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      function isValidEmergencyProfile(data, uid) {
        return data.keys().hasOnly([
            'id', 'userId', 'fullName', 'bloodGroup', 'primaryHospital',
            'accounts', 'policies', 'emergencyContacts', 'contacts',
            'importantDocumentLocations', 'instructionsNote', 'notes',
            'createdAt', 'updatedAt', 'deletedAt'
          ])
          && data.userId == uid
          && (!('id' in data) || (data.id is string && data.id.size() <= 128))
          && (data.accounts is list && data.accounts.size() <= 50)
          && (data.policies is list && data.policies.size() <= 50)
          && (!('emergencyContacts' in data) || (data.emergencyContacts is list && data.emergencyContacts.size() <= 20))
          && (!('contacts' in data) || (data.contacts is list && data.contacts.size() <= 20))
          && (!('fullName' in data) || isOptionalString(data.fullName, 128))
          && (!('bloodGroup' in data) || isOptionalString(data.bloodGroup, 16))
          && (!('primaryHospital' in data) || isOptionalString(data.primaryHospital, 256))
          && (!('importantDocumentLocations' in data) || isOptionalString(data.importantDocumentLocations, 2000))
          && (!('instructionsNote' in data) || isOptionalString(data.instructionsNote, 2000))
          && (!('notes' in data) || isOptionalString(data.notes, 2000))
          && (!('createdAt' in data) || isOptionalString(data.createdAt, 64))
          && isNonEmptyString(data.updatedAt, 64)
          && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64));
      }

      // ==========================================
      // 1. RPG SKILL TREE NODES (v1.8)
      // ==========================================
      match /skill_nodes/{nodeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(nodeId)
          && request.resource.data.userId == userId
          && isValidSkillNode(request.resource.data, nodeId, userId);
        allow update: if isOwner(userId)
          && isValidSkillNode(request.resource.data, nodeId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 2. WHITEBOARD ROUGH-WORK DRAWINGS (v1.8)
      // ==========================================
      match /whiteboard_drawings/{drawingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(drawingId)
          && request.resource.data.userId == userId
          && isValidWhiteboardDrawing(request.resource.data, drawingId, userId);
        allow update: if isOwner(userId)
          && isValidWhiteboardDrawing(request.resource.data, drawingId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 3. EXAM HALL SECTIONAL SIMULATOR (v1.8)
      // ==========================================
      match /exam_simulations/{simId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(simId)
          && request.resource.data.userId == userId
          && isValidExamSimulation(request.resource.data, simId, userId);
        allow update: if isOwner(userId)
          && isValidExamSimulation(request.resource.data, simId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 4. DECISION JOURNAL ENTRIES (v1.8)
      // ==========================================
      match /decision_entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.userId == userId
          && isValidDecisionEntry(request.resource.data, entryId, userId);
        allow update: if isOwner(userId)
          && isValidDecisionEntry(request.resource.data, entryId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 5. DOOMSCROLL SELF-TAX JAR LOGS (v1.8)
      // ==========================================
      match /doomscroll_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(logId)
          && request.resource.data.userId == userId
          && isValidDoomscrollLog(request.resource.data, logId, userId);
        allow update: if isOwner(userId)
          && isValidDoomscrollLog(request.resource.data, logId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 6. LIFE-IN-WEEKS MILESTONES (v1.8)
      // ==========================================
      match /life_milestones/{milestoneId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(milestoneId)
          && request.resource.data.userId == userId
          && isValidLifeMilestone(request.resource.data, milestoneId, userId);
        allow update: if isOwner(userId)
          && isValidLifeMilestone(request.resource.data, milestoneId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 7. TIME CAPSULE LETTERS TO FUTURE SELF (v1.8)
      // ==========================================
      match /time_capsules/{capsuleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(capsuleId)
          && request.resource.data.userId == userId
          && isValidTimeCapsule(request.resource.data, capsuleId, userId);
        allow update: if isOwner(userId)
          && isValidTimeCapsule(request.resource.data, capsuleId, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 8. PRINTABLE EMERGENCY & ASSET PROFILE (v1.8)
      // ==========================================
      match /emergency_profile/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(profileId)
          && request.resource.data.userId == userId
          && isValidEmergencyProfile(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidEmergencyProfile(request.resource.data, userId)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // SERVER-MANAGED INTEGRATIONS & PUSH TOKENS
      // ==========================================
      // Direct client reads and writes are strictly forbidden.
      // All operations are executed exclusively through authenticated backend services via Admin SDK.
      match /integrations/{integrationId} {
        allow read, write: if false;
      }

      match /fcm_installations/{installationId} {
        allow read, write: if false;
      }

      match /calendar_event_links/{linkId} {
        allow read, write: if false;
      }

      match /notification_delivery_ledger/{entryId} {
        allow read, write: if false;
      }
    }

    // ==========================================
    // JOINT VAULT & INVITATION SHARED HELPERS
    // ==========================================
    // Assumed Data Models (Keyless Hardened Joint Vault Architecture):
    //
    // Collection: vaultInvitations/{inviteCode} (canonical top-level, unenumerable)
    //   - id: string (valid ID) [immutable]
    //   - vaultId: string (valid ID) [immutable]
    //   - vaultName: string (1..128) [immutable]
    //   - invitedByUid: string (== creator auth.uid) [immutable]
    //   - invitedByName: string (1..128) [immutable]
    //   - inviteCode: string (16..32, ^[A-Z2-9]+$, == doc ID) [immutable]
    //   - invitedEmail: optional string (<= 256) or null [immutable]
    //   - status: 'pending' -> 'accepted' | 'rejected' | 'revoked'
    //   - createdAt: ISO date string [immutable]
    //   - createdAtTimestamp: server timestamp (== request.time) [immutable]
    //   - expiresAt: ISO date string [immutable]
    //   - expiresAtTimestamp: timestamp (> request.time && <= request.time + 30d) [immutable]
    //   - acceptedByUid / acceptedAt / acceptedAtTimestamp (on accept)
    //   - rejectedByUid / rejectedAt / rejectedAtTimestamp (on reject)
    //   - revokedByUid / revokedAt / revokedAtTimestamp (on revoke)
    //   - updatedAt: ISO date string
    //
    // Collection: sharedVaults/{vaultId}
    //   - id, name, description, currency, targetPaise, monthlyTargetPaise,
    //     createdBy, memberUids (size 1..2), targetRatio (exact integer sum == 100),
    //     status ('active' | 'archived'), createdAt, updatedAt, updatedAtTimestamp,
    //     lastAcceptedInviteCode, archivedAt, archivedAtTimestamp, archivedByUid
    //   Subcollections: members/{memberUid}, invitations/{inviteId} (legacy),
    //     contributions/{contribId}, expenses/{expenseId}, settlements/{settleId},
    //     activity/{activityId}
    // ==========================================

    function getVaultDoc(vId) {
      return get(/databases/$(database)/documents/sharedVaults/$(vId));
    }

    function getVaultDocAfter(vId) {
      return getAfter(/databases/$(database)/documents/sharedVaults/$(vId));
    }

    function isValidInviteCode(code) {
      return code is string
        && code.size() >= 16
        && code.size() <= 32
        && code.matches('^[A-Z2-9]+$');
    }

    function emailMatchesInvite(inviteData) {
      let invited = inviteData.get('invitedEmail', null);
      return invited == null
        || invited == ''
        || (
          invited is string
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', null) is string
          && request.auth.token.email.lower() == invited.lower()
        );
    }

    // Single-get membership check (1 access call instead of exists + get)
    function isMemberOfVault(vId) {
      let v = getVaultDoc(vId);
      return isSignedIn()
        && v != null
        && ('memberUids' in v.data)
        && (request.auth.uid in v.data.memberUids);
    }

    // Single-get active vault membership check (1 access call)
    function isActiveMemberOfVault(vId) {
      let v = getVaultDoc(vId);
      return isSignedIn()
        && v != null
        && v.data.status == 'active'
        && ('memberUids' in v.data)
        && (request.auth.uid in v.data.memberUids);
    }

    // Single-getAfter membership check for atomic join/create transactions (1 access call)
    function isMemberOfVaultAfter(vId) {
      let v = getVaultDocAfter(vId);
      return isSignedIn()
        && v != null
        && ('memberUids' in v.data)
        && (request.auth.uid in v.data.memberUids);
    }

    // ==========================================
    // CANONICAL TOP-LEVEL VAULT INVITATIONS
    // ==========================================
    match /vaultInvitations/{inviteCode} {
      function isTargetVaultEligibleForInvite(vaultId) {
        let v = getVaultDoc(vaultId);
        return v != null
          && v.data.status == 'active'
          && ('memberUids' in v.data)
          && (request.auth.uid in v.data.memberUids)
          && v.data.memberUids.size() == 1;
      }

      function isVaultAtomicallyJoinedByAccept(vaultId, code) {
        let vBefore = getVaultDoc(vaultId);
        let vAfter = getVaultDocAfter(vaultId);
        return vBefore != null
          && vAfter != null
          && vBefore.data.status == 'active'
          && ('memberUids' in vBefore.data)
          && vBefore.data.memberUids.size() == 1
          && !(request.auth.uid in vBefore.data.memberUids)
          && ('memberUids' in vAfter.data)
          && vAfter.data.memberUids.size() == 2
          && (request.auth.uid in vAfter.data.memberUids)
          && vAfter.data.lastAcceptedInviteCode == code;
      }

      function isValidInvitationAccept(code) {
        let prev = resource.data;
        let next = request.resource.data;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'pending'
          && next.status == 'accepted'
          && request.auth.uid != prev.invitedByUid
          && prev.expiresAtTimestamp is timestamp
          && request.time < prev.expiresAtTimestamp
          && emailMatchesInvite(prev)
          && changed.hasOnly([
            'status',
            'acceptedByUid',
            'acceptedAt',
            'acceptedAtTimestamp',
            'updatedAt'
          ])
          && next.acceptedByUid == request.auth.uid
          && isIsoDate(next.acceptedAt)
          && next.acceptedAtTimestamp == request.time
          && isIsoDate(next.updatedAt)
          && isVaultAtomicallyJoinedByAccept(prev.vaultId, code);
      }

      function isValidInvitationReject() {
        let prev = resource.data;
        let next = request.resource.data;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'pending'
          && next.status == 'rejected'
          && request.auth.uid != prev.invitedByUid
          && prev.expiresAtTimestamp is timestamp
          && request.time < prev.expiresAtTimestamp
          && emailMatchesInvite(prev)
          && changed.hasOnly([
            'status',
            'rejectedByUid',
            'rejectedAt',
            'rejectedAtTimestamp',
            'updatedAt'
          ])
          && next.rejectedByUid == request.auth.uid
          && isIsoDate(next.rejectedAt)
          && next.rejectedAtTimestamp == request.time
          && isIsoDate(next.updatedAt);
      }

      function canRevokeVaultInvitation(vaultId, invitedByUid) {
        let v = getVaultDoc(vaultId);
        return v != null
          && ('memberUids' in v.data)
          && (request.auth.uid in v.data.memberUids)
          && (request.auth.uid == invitedByUid || request.auth.uid == v.data.createdBy);
      }

      function isValidInvitationRevoke() {
        let prev = resource.data;
        let next = request.resource.data;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'pending'
          && next.status == 'revoked'
          && changed.hasOnly([
            'status',
            'revokedByUid',
            'revokedAt',
            'revokedAtTimestamp',
            'updatedAt'
          ])
          && next.revokedByUid == request.auth.uid
          && isIsoDate(next.revokedAt)
          && next.revokedAtTimestamp == request.time
          && isIsoDate(next.updatedAt)
          && canRevokeVaultInvitation(prev.vaultId, prev.invitedByUid);
      }

      // Strictly block collection enumeration
      allow list: if false;

      // Preserve audit trail & prevent invite code replay
      allow delete: if false;

      // Point lookup only (split per-branch for minimal expression budget):
      // 1. Idempotent re-read by user who already accepted (0 gets)
      allow get: if isSignedIn()
        && resource != null
        && resource.data.status == 'accepted'
        && resource.data.acceptedByUid == request.auth.uid;

      // 2. Prospective recipient with valid pending unexpired code & email match (0 gets)
      allow get: if isSignedIn()
        && resource != null
        && resource.data.status == 'pending'
        && resource.data.expiresAtTimestamp is timestamp
        && request.time < resource.data.expiresAtTimestamp
        && emailMatchesInvite(resource.data);

      // 3. Active member of target vault (1 get)
      allow get: if isSignedIn()
        && resource != null
        && resource.data.vaultId is string
        && isValidId(resource.data.vaultId)
        && isMemberOfVault(resource.data.vaultId);

      allow create: if isSignedIn()
        && isValidInviteCode(inviteCode)
        && request.resource.data.keys().hasOnly([
          'id',
          'vaultId',
          'vaultName',
          'invitedByUid',
          'invitedByName',
          'inviteCode',
          'invitedEmail',
          'status',
          'createdAt',
          'createdAtTimestamp',
          'expiresAt',
          'expiresAtTimestamp'
        ])
        && request.resource.data.inviteCode == inviteCode
        && isValidId(request.resource.data.id)
        && isValidId(request.resource.data.vaultId)
        && isNonEmptyString(request.resource.data.vaultName, 128)
        && request.resource.data.invitedByUid == request.auth.uid
        && isNonEmptyString(request.resource.data.invitedByName, 128)
        && (
          !('invitedEmail' in request.resource.data)
          || request.resource.data.invitedEmail == null
          || (request.resource.data.invitedEmail is string && request.resource.data.invitedEmail.size() <= 256)
        )
        && request.resource.data.status == 'pending'
        && isIsoDate(request.resource.data.createdAt)
        && request.resource.data.createdAtTimestamp == request.time
        && isIsoDate(request.resource.data.expiresAt)
        && request.resource.data.expiresAtTimestamp is timestamp
        && request.resource.data.expiresAtTimestamp > request.time
        && request.resource.data.expiresAtTimestamp <= request.time + duration.value(30, 'd')
        && isTargetVaultEligibleForInvite(request.resource.data.vaultId);

      // 3 separate update statements so each transition gets its own fresh expression budget
      // (affectedKeys().hasOnly(...) mathematically locks all 11 immutable fields)
      allow update: if isSignedIn() && isValidInvitationAccept(inviteCode);
      allow update: if isSignedIn() && isValidInvitationReject();
      allow update: if isSignedIn() && isValidInvitationRevoke();
    }

    // ==========================================
    // COUPLE SHARED SAVINGS (JOINT VAULTS) ROOT
    // ==========================================
    match /sharedVaults/{vaultId} {
      function isValidVaultCreate(vId) {
        let uid = request.auth.uid;
        let data = request.resource.data;
        return isValidId(vId)
          && data.keys().hasOnly([
            'id',
            'name',
            'description',
            'currency',
            'targetPaise',
            'monthlyTargetPaise',
            'createdBy',
            'memberUids',
            'targetRatio',
            'status',
            'createdAt',
            'createdAtTimestamp',
            'updatedAt',
            'updatedAtTimestamp'
          ])
          && data.createdBy == uid
          && data.memberUids == [uid]
          && isPositivePaise(data.targetPaise)
          && data.currency in ['INR', 'USD', 'EUR', 'GBP']
          && data.status == 'active'
          && isNonEmptyString(data.name, 128)
          && (!('id' in data) || data.id == vId)
          && (!('description' in data) || (data.description is string && data.description.size() <= 512))
          && (!('monthlyTargetPaise' in data) || isNonNegativePaise(data.monthlyTargetPaise))
          && (!('targetRatio' in data) || isValidSoloRatio(data.targetRatio, uid))
          && (!('createdAt' in data) || isIsoDate(data.createdAt))
          && (!('updatedAt' in data) || isIsoDate(data.updatedAt))
          && (!('createdAtTimestamp' in data) || data.createdAtTimestamp == request.time)
          && (!('updatedAtTimestamp' in data) || data.updatedAtTimestamp == request.time);
      }

      function isValidNormalVaultUpdate() {
        let uid = request.auth.uid;
        let prev = resource.data;
        let next = request.resource.data;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'active'
          && (uid in prev.memberUids)
          && changed.hasOnly([
            'name',
            'description',
            'targetPaise',
            'monthlyTargetPaise',
            'targetRatio',
            'updatedAt',
            'updatedAtTimestamp'
          ])
          && isNonEmptyString(next.name, 128)
          && (!('description' in next) || (next.description is string && next.description.size() <= 512))
          && isPositivePaise(next.targetPaise)
          && (!('monthlyTargetPaise' in next) || isNonNegativePaise(next.monthlyTargetPaise))
          && (!('targetRatio' in next) || isValidTargetRatio(next.targetRatio, prev.memberUids))
          && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
          && (!('updatedAtTimestamp' in changed) || next.updatedAtTimestamp == request.time);
      }

      function isValidVaultArchive() {
        let uid = request.auth.uid;
        let prev = resource.data;
        let next = request.resource.data;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'active'
          && next.status == 'archived'
          && (uid in prev.memberUids)
          && (uid == prev.createdBy || prev.memberUids.size() == 1)
          && changed.hasOnly([
            'status',
            'archivedAt',
            'archivedAtTimestamp',
            'archivedByUid',
            'updatedAt',
            'updatedAtTimestamp'
          ])
          && next.archivedByUid == uid
          && isIsoDate(next.archivedAt)
          && next.archivedAtTimestamp == request.time
          && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
          && (!('updatedAtTimestamp' in changed) || next.updatedAtTimestamp == request.time);
      }

      function isValidPartnerJoinAtomicProof(vId, code, existingMemberUids) {
        let uid = request.auth.uid;
        let invData = get(/databases/$(database)/documents/vaultInvitations/$(code)).data;
        let invAfterData = getAfter(/databases/$(database)/documents/vaultInvitations/$(code)).data;
        return invData.vaultId == vId
          && invData.status == 'pending'
          && (invData.invitedByUid in existingMemberUids)
          && invData.expiresAtTimestamp is timestamp
          && request.time < invData.expiresAtTimestamp
          && emailMatchesInvite(invData)
          && invAfterData.status == 'accepted'
          && invAfterData.acceptedByUid == uid
          && getAfter(/databases/$(database)/documents/sharedVaults/$(vId)/members/$(uid)).data.status == 'active';
      }

      function isValidPartnerJoin(vId) {
        let uid = request.auth.uid;
        let prev = resource.data;
        let next = request.resource.data;
        let prevMembers = prev.memberUids;
        let nextMembers = next.memberUids;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'active'
          && prevMembers.size() == 1
          && !(uid in prevMembers)
          && changed.hasOnly([
            'memberUids',
            'targetRatio',
            'lastAcceptedInviteCode',
            'updatedAt',
            'updatedAtTimestamp'
          ])
          && nextMembers is list
          && nextMembers.size() == 2
          && nextMembers[0] == prevMembers[0]
          && nextMembers[1] == uid
          && ('targetRatio' in next)
          && ('lastAcceptedInviteCode' in next)
          && ('updatedAtTimestamp' in next)
          && isValidPairRatio(next.targetRatio, prevMembers[0], uid)
          && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
          && next.updatedAtTimestamp == request.time
          && isValidInviteCode(next.lastAcceptedInviteCode)
          && isValidPartnerJoinAtomicProof(vId, next.lastAcceptedInviteCode, prevMembers);
      }

      function isValidSelfLeave(vId) {
        let uid = request.auth.uid;
        let prev = resource.data;
        let next = request.resource.data;
        let prevMembers = prev.memberUids;
        let nextMembers = next.memberUids;
        let changed = next.diff(prev).affectedKeys();
        return prev.status == 'active'
          && prevMembers.size() == 2
          && (uid in prevMembers)
          && changed.hasOnly([
            'memberUids',
            'targetRatio',
            'updatedAt',
            'updatedAtTimestamp'
          ])
          && nextMembers is list
          && nextMembers.size() == 1
          && !(uid in nextMembers)
          && (nextMembers[0] in prevMembers)
          && isValidSoloRatio(next.targetRatio, nextMembers[0])
          && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
          && next.updatedAtTimestamp == request.time
          && getAfter(/databases/$(database)/documents/sharedVaults/$(vId)/members/$(uid)).data.status == 'left';
      }

      // Vault root document
      allow get: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() && isValidVaultCreate(vaultId);

      // 4 separate update statements (affectedKeys().hasOnly(...) locks all non-listed immutable fields)
      allow update: if isSignedIn() && isValidNormalVaultUpdate();
      allow update: if isSignedIn() && isValidVaultArchive();
      allow update: if isSignedIn() && isValidSelfLeave(vaultId);
      allow update: if isSignedIn() && isValidPartnerJoin(vaultId);

      allow delete: if false;

      // Subcollection: members
      match /members/{memberUid} {
        function isCreatorOfVault(vId) {
          let v = getVaultDoc(vId);
          return v != null
            && ('memberUids' in v.data)
            && (request.auth.uid in v.data.memberUids)
            && v.data.createdBy == request.auth.uid;
        }

        function isPartnerJoiningVault(vId) {
          let vBefore = getVaultDoc(vId);
          let vAfter = getVaultDocAfter(vId);
          return vBefore != null
            && vAfter != null
            && ('memberUids' in vBefore.data)
            && !(request.auth.uid in vBefore.data.memberUids)
            && ('memberUids' in vAfter.data)
            && (request.auth.uid in vAfter.data.memberUids);
        }

        function isMemberLeavingVault(vId) {
          let vBefore = getVaultDoc(vId);
          let vAfter = getVaultDocAfter(vId);
          return vBefore != null
            && vAfter != null
            && ('memberUids' in vBefore.data)
            && (request.auth.uid in vBefore.data.memberUids)
            && ('memberUids' in vAfter.data)
            && !(request.auth.uid in vAfter.data.memberUids);
        }

        function hasValidMemberCreateFields(memberUid) {
          let data = request.resource.data;
          return request.auth.uid == memberUid
            && isValidId(memberUid)
            && data.keys().hasOnly([
              'uid',
              'email',
              'name',
              'avatarUrl',
              'role',
              'status',
              'joinedAt',
              'joinedAtTimestamp',
              'updatedAt'
            ])
            && data.uid == memberUid
            && data.status == 'active'
            && isNonEmptyString(data.name, 128)
            && (!('email' in data) || isOptionalString(data.email, 256))
            && (!('avatarUrl' in data) || isOptionalString(data.avatarUrl, 512))
            && (!('updatedAt' in data) || isIsoDate(data.updatedAt));
        }

        function isValidCreatorMemberCreate(vId, memberUid) {
          let data = request.resource.data;
          return data.role == 'creator'
            && hasValidMemberCreateFields(memberUid)
            && (!('joinedAt' in data) || isIsoDate(data.joinedAt))
            && (!('joinedAtTimestamp' in data) || data.joinedAtTimestamp == request.time)
            && isCreatorOfVault(vId);
        }

        function isValidPartnerMemberCreate(vId, memberUid) {
          let data = request.resource.data;
          return data.role == 'partner'
            && hasValidMemberCreateFields(memberUid)
            && isIsoDate(data.joinedAt)
            && data.joinedAtTimestamp == request.time
            && isPartnerJoiningVault(vId);
        }

        function isValidMemberProfileUpdate(vId, memberUid) {
          let prev = resource.data;
          let next = request.resource.data;
          let changed = next.diff(prev).affectedKeys();
          return request.auth.uid == memberUid
            && prev.status == 'active'
            && changed.hasOnly(['name', 'avatarUrl', 'updatedAt'])
            && (!('name' in next) || isNonEmptyString(next.name, 128))
            && (!('avatarUrl' in next) || isOptionalString(next.avatarUrl, 512))
            && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
            && isMemberOfVault(vId);
        }

        function isValidMemberSelfLeaveUpdate(vId, memberUid) {
          let prev = resource.data;
          let next = request.resource.data;
          let changed = next.diff(prev).affectedKeys();
          return request.auth.uid == memberUid
            && prev.status == 'active'
            && next.status == 'left'
            && changed.hasOnly(['status', 'leftAt', 'leftAtTimestamp', 'updatedAt'])
            && isIsoDate(next.leftAt)
            && next.leftAtTimestamp == request.time
            && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
            && isMemberLeavingVault(vId);
        }

        function isValidMemberRejoinUpdate(vId, memberUid) {
          let prev = resource.data;
          let next = request.resource.data;
          let changed = next.diff(prev).affectedKeys();
          return request.auth.uid == memberUid
            && prev.status == 'left'
            && next.status == 'active'
            && changed.hasOnly([
              'status',
              'name',
              'email',
              'avatarUrl',
              'joinedAt',
              'joinedAtTimestamp',
              'updatedAt'
            ])
            && isNonEmptyString(next.name, 128)
            && (!('email' in next) || isOptionalString(next.email, 256))
            && (!('avatarUrl' in next) || isOptionalString(next.avatarUrl, 512))
            && isIsoDate(next.joinedAt)
            && next.joinedAtTimestamp == request.time
            && (!('updatedAt' in next) || isIsoDate(next.updatedAt))
            && isPartnerJoiningVault(vId);
        }

        allow read: if isMemberOfVault(vaultId);

        // 2 separate create statements (Creator Setup vs Partner Atomic Join)
        allow create: if isSignedIn() && isValidCreatorMemberCreate(vaultId, memberUid);
        allow create: if isSignedIn() && isValidPartnerMemberCreate(vaultId, memberUid);

        // 3 separate update statements (Profile Update vs Atomic Self-Leave vs Atomic Re-Join)
        // (affectedKeys().hasOnly(...) mathematically locks uid, role, and non-listed fields)
        allow update: if isSignedIn() && isValidMemberProfileUpdate(vaultId, memberUid);
        allow update: if isSignedIn() && isValidMemberSelfLeaveUpdate(vaultId, memberUid);
        allow update: if isSignedIn() && isValidMemberRejoinUpdate(vaultId, memberUid);

        allow delete: if false;
      }

      // Subcollection: invitations (legacy subcollection retained for backward compatibility)
      match /invitations/{inviteId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isMemberOfVault(vaultId)
          && isValidId(inviteId)
          && request.resource.data.invitedByUid == request.auth.uid
          && request.resource.data.vaultId == vaultId
          && isNonEmptyString(request.resource.data.inviteCode, 64)
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'accepted', 'rejected', 'expired', 'revoked']);
        allow update: if isMemberOfVault(vaultId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'updatedAt'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'accepted', 'rejected', 'expired', 'revoked']);
        allow delete: if false;
      }

      // Subcollection: contributions
      match /contributions/{contribId} {
        function isValidContributionReversal(vId) {
          let prev = resource.data;
          let next = request.resource.data;
          let changed = next.diff(prev).affectedKeys();
          return isActiveMemberOfVault(vId)
            && prev.status == 'active'
            && prev.contributedByUid == request.auth.uid
            && next.status == 'reversed'
            && next.reversedByUid == request.auth.uid
            && changed.hasOnly([
              'status',
              'reversedByUid',
              'reversalReason',
              'reversedAt',
              'reversedAtTimestamp',
              'updatedAt'
            ])
            && (!('reversalReason' in next) || (next.reversalReason is string && next.reversalReason.size() <= 512))
            && (!('reversedAt' in next) || isIsoDate(next.reversedAt))
            && (!('reversedAtTimestamp' in next) || next.reversedAtTimestamp == request.time)
            && (!('updatedAt' in next) || isIsoDate(next.updatedAt));
        }

        allow read: if isMemberOfVault(vaultId);
        allow create: if isActiveMemberOfVault(vaultId)
          && isValidId(contribId)
          && request.resource.data.keys().hasOnly([
            'id',
            'vaultId',
            'contributedByUid',
            'contributorName',
            'amountPaise',
            'date',
            'description',
            'createdAt',
            'status'
          ])
          && (!('id' in request.resource.data) || request.resource.data.id == contribId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.contributedByUid == request.auth.uid
          && (!('contributorName' in request.resource.data) || isNonEmptyString(request.resource.data.contributorName, 128))
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.status == 'active'
          && isIsoDate(request.resource.data.date)
          && (!('createdAt' in request.resource.data) || isIsoDate(request.resource.data.createdAt))
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 256));
        allow update: if isValidContributionReversal(vaultId);
        allow delete: if false;
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        function isValidExpenseReversal(vId) {
          let prev = resource.data;
          let next = request.resource.data;
          let changed = next.diff(prev).affectedKeys();
          return isActiveMemberOfVault(vId)
            && prev.status == 'active'
            && prev.paidByUid == request.auth.uid
            && next.status == 'reversed'
            && next.reversedByUid == request.auth.uid
            && changed.hasOnly([
              'status',
              'reversedByUid',
              'reversalReason',
              'reversedAt',
              'reversedAtTimestamp',
              'updatedAt'
            ])
            && (!('reversalReason' in next) || (next.reversalReason is string && next.reversalReason.size() <= 512))
            && (!('reversedAt' in next) || isIsoDate(next.reversedAt))
            && (!('reversedAtTimestamp' in next) || next.reversedAtTimestamp == request.time)
            && (!('updatedAt' in next) || isIsoDate(next.updatedAt));
        }

        allow read: if isMemberOfVault(vaultId);
        allow create: if isActiveMemberOfVault(vaultId)
          && isValidId(expenseId)
          && request.resource.data.keys().hasOnly([
            'id',
            'vaultId',
            'paidByUid',
            'payerName',
            'amountPaise',
            'description',
            'date',
            'splitMode',
            'memberShares',
            'createdAt',
            'status'
          ])
          && (!('id' in request.resource.data) || request.resource.data.id == expenseId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.paidByUid == request.auth.uid
          && (!('payerName' in request.resource.data) || isNonEmptyString(request.resource.data.payerName, 128))
          && isPositivePaise(request.resource.data.amountPaise)
          && request.resource.data.status == 'active'
          && isIsoDate(request.resource.data.date)
          && isNonEmptyString(request.resource.data.description, 256)
          && request.resource.data.splitMode in ['equal', 'custom', 'ratio']
          && (!('memberShares' in request.resource.data) || (request.resource.data.memberShares is map && request.resource.data.memberShares.size() <= 2))
          && (!('createdAt' in request.resource.data) || isIsoDate(request.resource.data.createdAt));
        allow update: if isValidExpenseReversal(vaultId);
        allow delete: if false;
      }

      // Subcollection: settlements
      match /settlements/{settleId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isActiveMemberOfVault(vaultId)
          && isValidId(settleId)
          && request.resource.data.keys().hasOnly([
            'id',
            'vaultId',
            'fromUid',
            'fromName',
            'toUid',
            'toName',
            'amountPaise',
            'date',
            'notes',
            'createdAt'
          ])
          && (!('id' in request.resource.data) || request.resource.data.id == settleId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.fromUid == request.auth.uid
          && (!('fromName' in request.resource.data) || isNonEmptyString(request.resource.data.fromName, 128))
          && isPositivePaise(request.resource.data.amountPaise)
          && isNonEmptyString(request.resource.data.toUid, 128)
          && (!('toName' in request.resource.data) || isNonEmptyString(request.resource.data.toName, 128))
          && isIsoDate(request.resource.data.date)
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 512))
          && (!('createdAt' in request.resource.data) || isIsoDate(request.resource.data.createdAt));
        allow update, delete: if false;
      }

      // Subcollection: activity
      match /activity/{activityId} {
        allow read: if isMemberOfVault(vaultId);
        allow create: if isSignedIn()
          && isValidId(activityId)
          && request.resource.data.keys().hasOnly([
            'id',
            'vaultId',
            'actorUid',
            'actorName',
            'type',
            'title',
            'description',
            'amountPaise',
            'timestamp',
            'serverTimestamp',
            'metadata'
          ])
          && (!('id' in request.resource.data) || request.resource.data.id == activityId)
          && request.resource.data.vaultId == vaultId
          && request.resource.data.actorUid == request.auth.uid
          && (!('actorName' in request.resource.data) || isNonEmptyString(request.resource.data.actorName, 128))
          && (!('type' in request.resource.data) || isNonEmptyString(request.resource.data.type, 64))
          && isNonEmptyString(request.resource.data.title, 128)
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 512))
          && (!('amountPaise' in request.resource.data) || isPositivePaise(request.resource.data.amountPaise))
          && isIsoDate(request.resource.data.timestamp)
          && (!('serverTimestamp' in request.resource.data) || request.resource.data.serverTimestamp == request.time)
          && (!('metadata' in request.resource.data) || (request.resource.data.metadata is map && request.resource.data.metadata.size() <= 16))
          && (isMemberOfVault(vaultId) || isMemberOfVaultAfter(vaultId));
        allow update, delete: if false;
      }
    }

    // ==========================================
    // GOOGLE DRIVE DUPLICATION IDEMPOTENCY
    // ==========================================
    // Server-managed durable duplication idempotency records.
    // Client write is strictly forbidden under all circumstances.
    // Authenticated users may read their own idempotency records.
    match /driveIdempotency/{operationId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // ==========================================
    // EPHEMERAL OAUTH STATES
    // ==========================================
    // Server-managed only; client direct access strictly forbidden
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }
  }
}
