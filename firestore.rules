              isNonEmptyString(request.resource.data.title, 256)
              && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'in_progress', 'completed', 'skipped'])
              && (!('priority' in request.resource.data) || request.resource.data.priority in ['low', 'medium', 'high'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'subjectId', 'topicId', 'scheduledDate', 'startTime', 'endTime', 'estimatedMinutes', 'actualMinutes', 'priority', 'status', 'completedAt', 'updatedAt', 'deletedAt'])
            )
