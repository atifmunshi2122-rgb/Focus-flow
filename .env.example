# ==============================================================================
# FocusFlow & Finance — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env or set these in your production host environment.
# Never commit real secrets, API keys, or private keys to source control.
# ==============================================================================

# Node & Server Runtime
NODE_ENV="production"
PORT="3000"
APP_URL="https://focusflow.yourdomain.com"

# API Security & Tenant Isolation
# In production, set REQUIRE_AUTH="true" to strictly enforce verified Firebase ID tokens.
REQUIRE_AUTH="true"

# Allowed CORS origins (comma-separated, or single origin matching APP_URL)
ALLOWED_ORIGINS="https://focusflow.yourdomain.com"

# Rate Limiting (Sliding Window per IP)
RATE_LIMIT_MAX_REQUESTS="300"
RATE_LIMIT_WINDOW_MS="60000"

# Firebase Server & Token Verification
FIREBASE_PROJECT_ID="your-production-firebase-project-id"

# Frontend / Vite Firebase Client Configuration
# (These are public web client credentials loaded by Vite at build/runtime)
VITE_FIREBASE_API_KEY="AIzaSyYourProductionApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-production-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-production-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-production-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_DATABASE_ID="your-production-firestore-database-id"
