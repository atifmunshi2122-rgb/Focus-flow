# ==============================================================================
# FocusFlow & Finance — Multi-Environment Configuration Reference (.env.example)
# ==============================================================================
# IMPORTANT:
# - Do NOT put real production credentials or private keys in this file.
# - Do NOT commit .env or .env.local to source control.
# - In Vercel, configure environment variables separately under their respective scopes:
#   * Production Scope
#   * Preview Scope (Staging)
#   * Development Scope (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION SCOPE (Configure in Vercel Dashboard -> Environment: Production)
# ------------------------------------------------------------------------------
NODE_ENV="production"
APP_URL="https://focus-flow-by-atif.vercel.app"
ALLOWED_ORIGINS="https://focus-flow-by-atif.vercel.app"
REQUIRE_AUTH="true"
ALLOW_GUEST="false"
TRUST_PROXY="1"

# Production Backend Token Verification & Firebase Admin SDK
FIREBASE_PROJECT_ID="focus-flow-by-atif"

# Firebase Admin SDK Service Account (Server-Side Secret - NEVER prefix with VITE_)
# Paste the entire service account JSON object as a single-line string.
# IMPORTANT: Set BOTH FIREBASE_SERVICE_ACCOUNT_JSON (read by server/firebaseAdmin.ts)
# AND FIREBASE_SERVICE_ACCOUNT_KEY (read by server/vaultBackendService.ts & server/durableIdempotencyLedger.ts)
# to the same single-line JSON string in Vercel Production.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"focus-flow-by-atif","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@focus-flow-by-atif.iam.gserviceaccount.com"}'
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"focus-flow-by-atif","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@focus-flow-by-atif.iam.gserviceaccount.com"}'

# Production Frontend Web Client SDK (Vite - Public values embedded at build time)
VITE_FIREBASE_API_KEY="AIzaSyBYl8FBizO0sOEy7DOrHl1dUtsPixuIdpI"
VITE_FIREBASE_AUTH_DOMAIN="focus-flow-by-atif.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="focus-flow-by-atif"
VITE_FIREBASE_STORAGE_BUCKET="focus-flow-by-atif.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1010159085609"
VITE_FIREBASE_APP_ID="1:1010159085609:web:1d968f8d5359f5a0011438"
VITE_FIREBASE_MEASUREMENT_ID="G-H4D8JLHJQJ"
VITE_FIREBASE_DATABASE_ID="(default)"

# Google Drive Sheet Picker & Google Sheets API Integration
VITE_GOOGLE_PICKER_API_KEY="AIzaSyCw1wOxkYkJPoWcMrX4mc8E8rGxpxZXJMQ"
VITE_GOOGLE_SHEETS_API_KEY="AIzaSyCw1wOxkYkJPoWcMrX4mc8E8rGxpxZXJMQ"
VITE_GOOGLE_PROJECT_NUMBER="1010159085609"

# Google Calendar Integration (OAuth 2.0 Backend & Frontend)
GOOGLE_CALENDAR_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="https://focus-flow-by-atif.vercel.app/api/integrations/google-calendar/oauth/callback"
VITE_GOOGLE_CALENDAR_API_KEY="AIzaSyDZFq6pp77Kp9zMSKVQSY-wb8xlWCcEcS8"

# Integration Token Encryption & Security Secrets
# 32-byte hexadecimal string used for AES-256-GCM token encryption at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY="your-32-byte-hex-crypto-encryption-key"

# Cron Endpoint Secret (used by Vercel Cron to trigger notifications & sync)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="your-high-entropy-cron-secret-token"

# Firebase Cloud Messaging Integration (Push Notifications)
VITE_FIREBASE_VAPID_KEY="your-fcm-web-push-certificates-vapid-public-key"
VITE_FIREBASE_MESSAGING_API_KEY="AIzaSyC9JOdO981WILoxGBjlIf1-hA-dRKkE0Fk"

# ------------------------------------------------------------------------------
# 2. OPTIONAL: GOOGLE APPS SCRIPT WRITE-BACK BRIDGE (Backend Server Only)
# ------------------------------------------------------------------------------
# APPS_SCRIPT_WEBAPP_URL="https://script.google.com/macros/s/AKfycb.../exec"
# APPS_SCRIPT_WEBHOOK_SECRET="your-32-char-cryptographic-hex-secret"
# APPS_SCRIPT_ALLOWLISTED_SPREADSHEETS="*"

# ------------------------------------------------------------------------------
# 3. PREVIEW SCOPE (Configure in Vercel Dashboard -> Environment: Preview)
# ------------------------------------------------------------------------------
# CRITICAL SAFETY RULE:
# Never set Preview to point to the Production Project ID (focus-flow-by-atif)
# or Production Database ID ((default)).
# A dedicated Staging Firebase Project & Database MUST be used to protect production data.
# If missing, Preview builds fail closed with a configuration error.

# VITE_APP_ENV="preview"
# FIREBASE_PROJECT_ID="your-staging-firebase-project-id"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-staging-firebase-project-id",...}'
# VITE_FIREBASE_API_KEY="AIzaSyYourStagingApiKey"
# VITE_FIREBASE_AUTH_DOMAIN="your-staging-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-staging-firebase-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-staging-project.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="999888777666"
# VITE_FIREBASE_APP_ID="1:999888777666:web:yourstagingappid"
# VITE_FIREBASE_DATABASE_ID="staging-firestore-database-id"

# ------------------------------------------------------------------------------
# 4. LOCAL DEVELOPMENT SCOPE (Copy to .env.local for local machine dev)
# ------------------------------------------------------------------------------
# NODE_ENV="development"
# PORT="3000"
# REQUIRE_AUTH="false"
# ALLOW_GUEST="true"
# VITE_FIREBASE_PROJECT_ID="focus-flow-by-atif"
# VITE_FIREBASE_DATABASE_ID="(default)"
