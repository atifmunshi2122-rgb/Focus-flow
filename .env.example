# ==============================================================================
# FocusFlow & Finance — Multi-Environment Configuration Reference (.env.example)
# ==============================================================================
# IMPORTANT:
# - Do NOT put real production credentials in this file.
# - Do NOT commit .env or .env.local to source control.
# - In Vercel, configure environment variables separately under their respective scopes:
#   * Production Scope
#   * Preview Scope (Staging)
#   * Development Scope (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION SCOPE (Configure in Vercel Dashboard -> Environment: Production)
# ------------------------------------------------------------------------------
# Target Project: Dedicated Production Firebase Project
NODE_ENV="production"
PORT="3000"
APP_URL="https://focus-flow-by-atif.vercel.app"
ALLOWED_ORIGINS="https://focus-flow-by-atif.vercel.app"
REQUIRE_AUTH="true"
ALLOW_GUEST="false"

# Production Backend Token Verification
FIREBASE_PROJECT_ID="seismic-codex-m01dl"

# Production Frontend Web Client SDK (Vite)
VITE_FIREBASE_API_KEY="AIzaSyYourProductionApiKey"
VITE_FIREBASE_AUTH_DOMAIN="seismic-codex-m01dl.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seismic-codex-m01dl"
VITE_FIREBASE_STORAGE_BUCKET="seismic-codex-m01dl.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="363778207392"
VITE_FIREBASE_APP_ID="1:363778207392:web:yourproductionappid"
VITE_FIREBASE_DATABASE_ID="ai-studio-focusflowfinance-34a065b9-d0d0-4728-b07d-d2b9028624a8"

# ------------------------------------------------------------------------------
# 2. PREVIEW SCOPE (Configure in Vercel Dashboard -> Environment: Preview)
# ------------------------------------------------------------------------------
# CRITICAL SAFETY RULE:
# Never set Preview to point to the Production Project ID (seismic-codex-m01dl)
# or Production Database ID (ai-studio-focusflowfinance-34a065b9-d0d0-4728-b07d-d2b9028624a8).
# A dedicated Staging Firebase Project & Database must be used to protect production data.
# If missing, Preview builds fail closed with a configuration error.

# Preview Environment Tier Flag (or automatically set by Vercel as VERCEL_ENV="preview")
VITE_APP_ENV="preview"

# Staging Backend Token Verification
# FIREBASE_PROJECT_ID="your-staging-firebase-project-id"

# Staging Frontend Web Client SDK (Vite)
# VITE_FIREBASE_API_KEY="AIzaSyYourStagingApiKey"
# VITE_FIREBASE_AUTH_DOMAIN="your-staging-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-staging-firebase-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-staging-project.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="999888777666"
# VITE_FIREBASE_APP_ID="1:999888777666:web:yourstagingappid"
# VITE_FIREBASE_DATABASE_ID="staging-firestore-database-id"

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT SCOPE (Copy to .env.local for local machine dev)
# ------------------------------------------------------------------------------
# NODE_ENV="development"
# PORT="3000"
# REQUIRE_AUTH="false"
# ALLOW_GUEST="true"
# VITE_FIREBASE_PROJECT_ID="your-local-or-staging-project-id"
# VITE_FIREBASE_DATABASE_ID="your-local-or-staging-database-id"
